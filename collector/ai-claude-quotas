#!/usr/bin/env python3
"""Read Claude quotas using proxy-owned access tokens, without refresh or writes.

The direct usage endpoint is the primary source. When it rejects or fails the request after
retries, the observation falls back to the newer of: the quota the proxy read from response
headers of the account's own traffic (no extra provider request), and the last successful
observation, each usable for at most STALE_SECONDS. A fallback entry keeps `ok` and `data` so
consumers show a number with its age instead of forgetting it, and records under `direct`
how the direct request ended so nothing pretends the check succeeded.

A 429 is not retried: the provider asked us to back off, and retrying within the same run only
extends the block. Its `Retry-After` becomes `direct.retry_after_until`, and later runs skip the
direct request until then. The proxy's own view of the OAuth credential (from its management
API, passed alongside the header quota) marks entries whose credential needs a re-login.

A back-off belongs to the token that was refused, not to the address: it is stamped with a one-way
fingerprint of that token, and a credential the proxy re-issued after a re-login (new file, new token)
reads directly at once instead of waiting out the dead token's deadline. The Fable weekly allowance is
not in the account-wide headers; the proxy records it per model (`7d_oi` on claude-fable* responses), so a
header fallback takes it from there, and says so when neither source holds it."""
import hashlib
import json
import os
import random
import re
import time
from email.utils import parsedate_to_datetime
from pathlib import Path
from datetime import datetime, timedelta, timezone
from urllib.error import HTTPError
from urllib.request import Request, urlopen

# Uniform jitter inside each band: a second poller on the same account must not collide again on retry.
RETRY_DELAYS = ((3, 6), (8, 14))
RETRIED = {500, 502, 503, 504}
# Transient outcomes may fall back to an older number; a 429 is transient but never retried in-run.
TRANSIENT = RETRIED | {429}
# One 5-hour window: an observation older than that may describe a window that has already reset.
STALE_SECONDS = 5 * 3600
DEFAULT_BACKOFF = timedelta(minutes=15)
# The proxy reports a dead refresh token in its status message, in a few spellings.
EXPIRED_AUTH = re.compile(r'invalid[ _-]?grant|authentication[ _-]?error|re-?authenticat', re.IGNORECASE)
EXPIRED_ERROR = 'Proxy OAuth expired — re-login proxy'


def credential_id(provider, email):
    """The credential's identity across proxy renames: provider and account e-mail. The proxy renames an auth file
    on re-login (adding an org hash), which changes the file-name identity every consumer keyed on."""
    return hashlib.sha256(('oauth-account:%s:%s' % (provider, email.strip().lower())).encode()).hexdigest()[:24]


def token_fingerprint(token):
    """A one-way, truncated fingerprint that ties a back-off to the token it was issued for."""
    return hashlib.sha256(('quota-backoff:%s' % token).encode()).hexdigest()[:16] if token else None


FABLE_MODEL = re.compile(r'^claude-fable', re.IGNORECASE)


def parse_time(value):
    try:
        parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
        return parsed if parsed.tzinfo else None
    except (AttributeError, ValueError, TypeError):
        return None


def retry_after_until(value, now):
    """Deadline from a Retry-After header (delta seconds or HTTP-date), DEFAULT_BACKOFF when absent
    or unparseable, capped at STALE_SECONDS so a bogus header cannot silence the check for good."""
    deadline = None
    if value is not None:
        text = str(value).strip()
        try:
            deadline = now + timedelta(seconds=max(0, int(text)))
        except ValueError:
            try:
                parsed = parsedate_to_datetime(text)
                deadline = parsed if parsed.tzinfo else None
            except (TypeError, ValueError, IndexError):
                deadline = None
    if deadline is None:
        deadline = now + DEFAULT_BACKOFF
    return min(deadline, now + timedelta(seconds=STALE_SECONDS)).astimezone(timezone.utc)


def header(headers, name):
    try:
        return next((v for k, v in (headers or {}).items() if str(k).lower() == name), None)
    except AttributeError:
        return None


def request_quota(request, open_url, sleep, validate, error_text):
    """One direct request with bounded retries. Returns (ok, status, data_or_error, retry_after):
    retry_after is the raw Retry-After header of a 429, otherwise None."""
    for delay in RETRY_DELAYS + (None,):
        try:
            with open_url(request, timeout=15) as response:
                data = json.load(response)
                validate(data)
                return True, 200, data, None
        except HTTPError as error:
            code, retry_after = error.code, header(error.headers, 'retry-after')
            error.close()
            if code not in RETRIED or delay is None:
                return False, code, 'Proxy quota request rejected (HTTP %s)' % code, retry_after if code == 429 else None
        except ValueError:
            return False, None, error_text, None
        except Exception:
            if delay is None:
                return False, None, error_text, None
        sleep(random.uniform(*delay))


def proxy_quota_payload(signals):
    """Anthropic rate-limit headers, as the proxy stored them, in the usage endpoint's shape."""
    if not isinstance(signals, dict):
        return None
    lower = {str(k).lower(): v for k, v in signals.items()}
    windows = {}
    for kind, prefix in (('five_hour', '5h'), ('seven_day', '7d')):
        try:
            used = float(lower['anthropic-ratelimit-unified-%s-utilization' % prefix]) * 100
            reset = datetime.fromtimestamp(int(lower['anthropic-ratelimit-unified-%s-reset' % prefix]), timezone.utc)
        except (KeyError, ValueError, TypeError, OverflowError, OSError):
            continue
        if 0 <= used <= 100:
            windows[kind] = {'utilization': round(used, 2), 'resets_at': reset.isoformat()}
    return windows or None


def proxy_scoped_limits(model_quotas, now):
    """The Fable weekly allowance as the proxy last saw it on a claude-fable* response (`7d_oi` headers), in the usage
    endpoint's `weekly_scoped` shape and stamped with its observation time. An exhausted allowance stays true until its
    reset whatever its age (usage only grows inside a window); a lower value is used for STALE_SECONDS like any header."""
    best = None
    for model, observation in (model_quotas or {}).items() if isinstance(model_quotas, dict) else ():
        if not FABLE_MODEL.match(str(model)) or not isinstance(observation, dict):
            continue
        lower = {str(k).lower(): v for k, v in (observation.get('signals') or {}).items()}
        observed = parse_time(observation.get('observed_at'))
        try:
            used = float(lower['anthropic-ratelimit-unified-7d_oi-utilization']) * 100
            reset = datetime.fromtimestamp(int(lower['anthropic-ratelimit-unified-7d_oi-reset']), timezone.utc)
        except (KeyError, ValueError, TypeError, OverflowError, OSError):
            continue
        if not observed or reset <= now or not 0 <= used <= 100 or observed > now:
            continue
        if used < 100 and (now - observed).total_seconds() > STALE_SECONDS:
            continue
        status = str(lower.get('anthropic-ratelimit-unified-7d_oi-status') or '').lower()
        limit = {'kind': 'weekly_scoped', 'group': 'weekly', 'percent': round(used, 2),
                 'severity': 'critical' if used >= 100 or status == 'rejected' else 'warning' if used >= 75 else 'normal',
                 'resets_at': reset.isoformat(), 'scope': {'model': {'id': None, 'display_name': 'Fable'}, 'surface': None},
                 'is_active': status == 'rejected', 'observed_at': observed.isoformat()}
        if best is None or observed > parse_time(best['observed_at']):
            best = limit
    return [best] if best else []


def load_proxy_rows(path, kind):
    """{email: row} of the wrapper's auth-file rows for one provider type; ambiguous emails are dropped."""
    if not path:
        return {}
    try:
        rows = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}
    seen = {}
    for row in rows if isinstance(rows, list) else []:
        if isinstance(row, dict) and row.get('type') == kind and row.get('email'):
            seen.setdefault(row['email'], []).append(row)
    return {email: found[0] for email, found in seen.items() if len(found) == 1}


def load_proxy_quota(path, kind):
    """{email: {observed_at, signals}} for credentials of one provider type; ambiguous emails are dropped."""
    return {email: dict(row['quota'], **({'model_quotas': row['model_quotas']} if isinstance(row.get('model_quotas'), dict) and row['model_quotas'] else {}))
            for email, row in load_proxy_rows(path, kind).items() if isinstance(row.get('quota'), dict)}


def load_proxy_auth(path, kind):
    """{email: {status, status_message, unavailable}}: the proxy's own view of each OAuth credential."""
    return {email: {'status': row.get('status'), 'status_message': row.get('status_message'), 'unavailable': row.get('unavailable')}
            for email, row in load_proxy_rows(path, kind).items()}


def auth_expired(auth):
    message = auth.get('status_message') if isinstance(auth, dict) else None
    return bool(message) and bool(EXPIRED_AUTH.search(str(message)))


def load_previous(path, bucket):
    if not path:
        return {}
    try:
        rows = json.loads(Path(path).read_text()).get(bucket)
    except (OSError, ValueError, AttributeError):
        return {}
    return rows if isinstance(rows, dict) else {}


def carried_scoped_limits(prior, now):
    """Per-model weekly allowances (limits of kind `weekly_scoped`, e.g. the Fable weekly) from the
    previous observation, each stamped with the time it was actually observed.

    Rate-limit headers only carry the account-wide 5-hour and 7-day windows, so a header-based
    fallback would otherwise drop the per-model allowance every time the direct request is refused.
    A carried limit keeps its original `observed_at` across consecutive fallbacks and is dropped once
    its window has reset or it is older than STALE_SECONDS."""
    if not isinstance(prior, dict) or not prior.get('ok') or not isinstance(prior.get('data'), dict):
        return []
    # A limit without its own stamp comes straight from the observation that holds it: a `direct` entry,
    # or a `retained` one whose fetched_at is still that direct observation's time. Header-based entries
    # never hold an unstamped scoped limit, because this function stamps every limit it carries.
    fallback_time = parse_time(prior.get('fetched_at'))
    carried = []
    for limit in prior['data'].get('limits') or []:
        if not isinstance(limit, dict) or limit.get('kind') != 'weekly_scoped':
            continue
        observed = parse_time(limit.get('observed_at')) or fallback_time
        resets = parse_time(limit.get('resets_at'))
        if not observed or not 0 <= (now - observed).total_seconds() <= STALE_SECONDS:
            continue
        if resets and resets <= now:
            continue
        carried.append(dict(limit, observed_at=observed.isoformat()))
    return carried


def fallback(entry, identity, email, previous, proxy_quota, now, to_payload, carry=None):
    """Replace a transiently failed direct observation with the newest honest alternative, if any.

    A definite rejection (401/403 and other non-retryable statuses) means the credential itself is
    the problem; no fallback may hide that behind a number, so the entry stays failed. When the
    proxy headers win and `carry` is given, what they cannot express is carried over from the
    previous observation by `carry(prior, now)`, stamped with its own observation time. Fields the
    entry already holds under `direct` (the 429 deadline, the original attempt time) survive."""
    if entry.get('status') is not None and entry['status'] not in TRANSIENT:
        return
    direct = {'status': entry.get('status'), 'error': entry.get('error'), 'attempted_at': entry['fetched_at'], **(entry.get('direct') or {})}
    candidates = []
    row = proxy_quota.get(email) if email else None
    if isinstance(row, dict):
        observed, data = parse_time(row.get('observed_at')), to_payload(row.get('signals'))
        if observed and data and 0 <= (now - observed).total_seconds() <= STALE_SECONDS:
            candidates.append((observed, 'proxy_headers', data))
    prior = previous.get(identity)
    if isinstance(prior, dict) and prior.get('ok') and isinstance(prior.get('data'), dict):
        observed = parse_time(prior.get('fetched_at'))
        if observed and 0 <= (now - observed).total_seconds() <= STALE_SECONDS:
            candidates.append((observed, 'retained', prior['data']))
    if not candidates:
        return
    observed, source, data = max(candidates, key=lambda item: item[0])
    if source == 'proxy_headers':
        limits = carry(prior, now) if carry else []
        if not limits and isinstance(row, dict):
            limits = proxy_scoped_limits(row.get('model_quotas'), now)
        # Without either, the card must not read "no scoped limit" as "nothing is limited".
        data = dict(data, limits=limits) if limits else dict(data, scoped_limits_observed=False)
    entry.pop('error', None)
    entry.update(ok=True, status=None, fetched_at=observed.isoformat(), data=data, source=source, direct=direct)


def validate(data):
    if not isinstance(data, dict) or not any(isinstance(data.get(k), dict) for k in ('five_hour', 'seven_day')):
        raise ValueError('Missing quota payload')


def pending_backoff(prior, now):
    """The previous run's 429 deadline for this identity while it is still in the future."""
    direct = prior.get('direct') if isinstance(prior, dict) else None
    deadline = parse_time(direct.get('retry_after_until')) if isinstance(direct, dict) else None
    return (deadline, direct) if deadline and deadline > now else (None, None)


def mark_proxy_auth(entry, auth, attempted):
    """Attach the proxy's verdict on the OAuth credential. Expired needs evidence: the proxy holds the credential in
    error (or unavailable) with a dead-login message, or the provider answered the token with 401. A direct success
    proves the token works, whatever an older status message still says. A healthy credential adds nothing."""
    if entry['ok'] and entry.get('source') == 'direct':
        return
    held = isinstance(auth, dict) and (auth.get('status') == 'error' or auth.get('unavailable') is True) and auth_expired(auth)
    rejected = not entry['ok'] and entry.get('status') == 401
    if not held and not rejected:
        return
    message = str(auth['status_message'])[:300] if held else 'Provider rejected the proxy credential (HTTP 401)'
    entry['proxy_auth'] = {'state': 'expired', 'message': message, 'observed_at': attempted.isoformat()}
    if not entry['ok']:
        entry['error'] = EXPIRED_ERROR


def collect(auth_dir, open_url=urlopen, previous=None, proxy_quota=None, sleep=time.sleep, now=None, proxy_auth=None):
    if not Path(auth_dir).is_dir():
        raise FileNotFoundError('Proxy auth inventory is unavailable')
    previous, proxy_quota, proxy_auth = previous or {}, proxy_quota or {}, proxy_auth or {}
    result = {}
    files = []
    for path in sorted(Path(auth_dir).glob('*.json')):
        try:
            auth = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(auth, dict) and auth.get('type') == 'claude':
            files.append((path, auth))
    # An address held by one credential only identifies it; with two, neither may inherit the other's history.
    holders = {}
    for _, auth in files:
        if isinstance(auth.get('email'), str) and auth['email'].strip():
            normalized = auth['email'].strip().lower()
            holders[normalized] = holders.get(normalized, 0) + 1
    for path, auth in files:
        identity = hashlib.sha256(('oauth:' + path.name).encode()).hexdigest()[:24]
        attempted = now or datetime.now(timezone.utc)
        entry = {'ok': False, 'fetched_at': attempted.isoformat(), 'status': None}
        token, email = auth.get('access_token'), auth.get('email')
        unique = isinstance(email, str) and email.strip() and holders.get(email.strip().lower()) == 1
        stable = credential_id('claude', email) if unique else None
        # The previous observation of this credential: by its own file id, or, after the proxy renamed the file, by the
        # stable or e-mail key when exactly one current credential holds the address.
        prior = previous.get(identity) if isinstance(previous.get(identity), dict) else None
        same_file = prior is not None
        if prior is None and unique:
            prior = next((previous[key] for key in (stable, email) if isinstance(previous.get(key), dict)), None)
        previous_view = {identity: prior} if prior else {}
        fingerprint = token_fingerprint(token)
        deadline, backoff = pending_backoff(prior, attempted)
        if deadline:
            # The deadline was issued to one token. A re-login gives the credential a new token (and file); keep the
            # deadline only for the token it was issued to, or for the same file when the entry predates fingerprints.
            issued_to = backoff.get('token_fp')
            if (issued_to and issued_to != fingerprint) or (not issued_to and not same_file):
                deadline, backoff = None, None
        if auth.get('disabled'):
            entry['error'] = 'Proxy account is disabled; quota was not queried'
        elif not token:
            entry['error'] = 'Proxy quota credentials are incomplete'
        elif deadline:
            # Still inside the provider's back-off: no request, the number comes from the fallback.
            error = 'Rate limited by the provider; next attempt after %s' % deadline.astimezone(timezone.utc).strftime('%H:%M UTC')
            entry.update(status=429, error=error, direct={'status': 429, 'error': error, 'attempted_at': backoff.get('attempted_at') or entry['fetched_at'],
                                                            'retry_after_until': deadline.isoformat(), 'token_fp': fingerprint})
            fallback(entry, identity, email, previous_view, proxy_quota, attempted, proxy_quota_payload, carried_scoped_limits)
        else:
            request = Request('https://api.anthropic.com/api/oauth/usage', headers={
                'Authorization': 'Bearer ' + token, 'anthropic-beta': 'oauth-2025-04-20', 'Accept': 'application/json'})
            ok, status, payload, retry_after = request_quota(request, open_url, sleep, validate, 'Proxy quota request failed; credentials were not refreshed')
            if ok:
                entry.update(ok=True, status=status, data=payload, source='direct')
            else:
                entry.update(status=status, error=payload)
                if status == 429:
                    entry['direct'] = {'status': 429, 'error': payload, 'attempted_at': entry['fetched_at'],
                                       'retry_after_until': retry_after_until(retry_after, attempted).isoformat(), 'token_fp': fingerprint}
                fallback(entry, identity, email, previous_view, proxy_quota, attempted, proxy_quota_payload, carried_scoped_limits)
        if not auth.get('disabled'):
            mark_proxy_auth(entry, proxy_auth.get(email) if email else None, attempted)
        result[identity] = entry
        if email and unique:
            # E-mail and stable keys only when one credential holds the address; the file-name key stays for old configs.
            result[email] = entry
            result[stable] = entry
    return result


if __name__ == '__main__':
    print(json.dumps(collect(os.environ['AI_BILLS_CLIPROXY_AUTH_DIR'],
                             previous=load_previous(os.environ.get('AI_BILLS_PREVIOUS_SNAPSHOT'), 'claude_usage'),
                             proxy_quota=load_proxy_quota(os.environ.get('AI_BILLS_PROXY_QUOTA_FILE'), 'claude'),
                             proxy_auth=load_proxy_auth(os.environ.get('AI_BILLS_PROXY_QUOTA_FILE'), 'claude'))))
