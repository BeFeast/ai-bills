#!/usr/bin/env python3
"""ai-usage-report — turn the token ledger into money.

Ledger rows are facts (tokens); prices live in the vault and are applied here, so
fixing a price re-prices history. Two figures per row:
  api_equivalent — cost at list price (what a subscription earns back)
  marginal       — estimated additional usage (unknown without account billing evidence)
A model absent from pricing.yml is reported as UNPRICED, never as $0.
"""
import argparse, glob, json, os, re, sys, collections, sqlite3
from pathlib import Path
from datetime import date, datetime, timezone
from zoneinfo import ZoneInfo

REPORT_TZ = ZoneInfo(os.environ.get("AI_USAGE_TIMEZONE", "Asia/Jerusalem"))

def local_day(ts=None):
    if ts is None:
        return datetime.now(REPORT_TZ).date().isoformat()
    try:
        value = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        if value.tzinfo is None: return ts[:10]
        return value.astimezone(REPORT_TZ).date().isoformat()
    except (ValueError, TypeError): return (ts or "")[:10]

LEDGER_DIR = os.path.expanduser(os.environ.get("AI_USAGE_LEDGER_DIR", "~/.local/state/ai-usage"))
PRICING = os.environ.get("AI_USAGE_PRICING", os.path.expanduser("~/.config/ai-usage/pricing.yml"))
ROUTING_DB = os.environ.get("AI_USAGE_ROUTING_DB")

def load_pricing():
    import yaml
    with open(PRICING) as fh:
        doc = yaml.safe_load(fh)
    return doc.get("defaults", {}), doc.get("models", {})

def lookup(model, models):
    """Match a logged model id against the price table.

    Clients log ids the price table does not carry verbatim: Anthropic dated
    snapshots (claude-haiku-4-5-20251001) and Ollama-style variant suffixes
    (glm-5.2:cloud). Both denote the same priced model, so fall back to the
    stripped form rather than reporting a priced model as UNPRICED.
    """
    if not model:
        return None
    p = models.get(model)
    if p:
        return p
    base = re.sub(r"-\d{8}$", "", model.split(":", 1)[0])
    return models.get(base) if base != model else None

def cost(row, defaults, models):
    """-> (api_equivalent_usd, marginal_usd, priced?)"""
    p = lookup(row.get("model"), models)
    if not p or p.get("in") is None:
        return 0.0, None, False  # caller separates "no entry" from "flat rate, no list price"
    tier = p.get("long_context")
    if tier is not None:
        # Context is the complete prompt, including cached input, never output.
        # Require every bucket: missing evidence cannot establish the price tier.
        inputs = [row.get(field) for field in ("in_uncached", "cache_read", "cache_write")]
        threshold = tier.get("input_tokens_above") if isinstance(tier, dict) else None
        if (not isinstance(threshold, int) or isinstance(threshold, bool) or threshold < 0
                or any(not isinstance(value, int) or isinstance(value, bool) or value < 0 for value in inputs)):
            return 0.0, None, False
        if sum(inputs) > threshold:
            # Long-context rates apply to all buckets and output, not just overflow.
            p = {**p, **tier}
            if tier.get("in") is None or tier.get("out") is None:
                return 0.0, None, False
    # Per-model overrides matter across providers: Anthropic charges 1.25x for a
    # cache write, OpenAI and Moonshot do not charge for one at all.
    cw = p.get("cache_write_multiplier", defaults.get("cache_write_multiplier", 1.25))
    cr = p.get("cache_read_multiplier", defaults.get("cache_read_multiplier", 0.1))
    pin, pout = float(p["in"]), float(p["out"])
    api = (
        (row.get("in_uncached") or 0) / 1e6 * pin
        + (row.get("cache_read") or 0) / 1e6 * pin * cr
        + (row.get("cache_write") or 0) / 1e6 * pin * cw
        + (row.get("out_total") or 0) / 1e6 * pout
    )
    mode = row.get("billing_mode")
    # A model can exist on subscription and paid accounts: never classify by model.
    marginal = 0.0 if mode == "included" else api if mode == "metered" else None
    return api, marginal, True

def attribute_routing(records):
    """Enrich the read projection only, using exact managed attempt/request IDs."""
    managed = [row for row in records if row.get("attempt_id") or row.get("managed_request_id")]
    if not managed:
        return records
    matches = {}
    by_request = collections.defaultdict(list)
    status = "unconfigured" if not ROUTING_DB else "unavailable"
    if ROUTING_DB:
        try:
            # mode=ro never creates a missing database or modifies gateway state.
            uri = Path(ROUTING_DB).expanduser().resolve().as_uri() + "?mode=ro"
            db = sqlite3.connect(uri, uri=True, timeout=1)
            try:
                db.row_factory = sqlite3.Row
                db.execute("PRAGMA query_only=ON")
                attempt_ids = {r["attempt_id"] for r in managed if r.get("attempt_id")}
                request_ids = {r["managed_request_id"] for r in managed if not r.get("attempt_id") and r.get("managed_request_id")}
                for field, identifiers in (("id", attempt_ids), ("request_id", request_ids)):
                    identifiers = sorted(identifiers)
                    for start in range(0, len(identifiers), 400):
                        batch = identifiers[start:start + 400]
                        query = ("SELECT id,request_id,client_id,session_id,role,account_id,billing,"
                                 "model,policy_version,fallback_reason FROM attempts WHERE " + field
                                 + " IN (" + ",".join("?" for _ in batch) + ")")
                        for result in db.execute(query, batch):
                            matches[result["id"]] = dict(result)
                for result in matches.values():
                    by_request[result["request_id"]].append(result)
                status = "unmatched"
            finally:
                db.close()
        except (sqlite3.Error, OSError, ValueError):
            matches.clear()
            by_request.clear()
            print("Routing attribution unavailable; preserving original ledger metadata", file=sys.stderr)
    projected = []
    for original in records:
        if not (original.get("attempt_id") or original.get("managed_request_id")):
            projected.append(original)
            continue
        row = dict(original, routing_attribution=status)
        attempt = matches.get(row.get("attempt_id"))
        if not row.get("attempt_id") and row.get("managed_request_id"):
            candidates = by_request[row["managed_request_id"]]
            if len(candidates) == 1:
                attempt = candidates[0]
            elif len(candidates) > 1:
                row["routing_attribution"] = "ambiguous"
        if attempt and row.get("managed_request_id") not in (None, "", attempt["request_id"]):
            row["routing_attribution"] = "id-mismatch"
            attempt = None
        if attempt:
            row.update(client=attempt["client_id"], account=attempt["account_id"],
                       attempt_id=attempt["id"], managed_request_id=attempt["request_id"],
                       session_id=attempt["session_id"], role=attempt["role"],
                       routing_model=attempt["model"], policy_version=attempt["policy_version"],
                       fallback_reason=attempt["fallback_reason"], routing_attribution="joined")
            mode = {"included": "included", "paid": "metered"}.get(attempt["billing"])
            if mode:
                row["billing_mode"] = mode
        projected.append(row)
    return projected

def rows_for(day):
    # Preserve raw ledger; reconcile observations in the read projection only.
    if not os.path.isdir(LEDGER_DIR):
        raise FileNotFoundError('Token ledger source is unavailable')
    records = []
    for path in sorted(glob.glob(os.path.join(LEDGER_DIR, "ledger-*.jsonl"))):
        with open(path) as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if day and local_day(row.get("ts")) != day:
                    continue
                records.append(row)
    # Proxy observation is preferred for matched native observations because it
    # carries selected account/attempt metadata. Do not merge separate attempts.
    proxy_ids = {r.get("upstream_request_id") for r in records if r.get("via") == "proxy" and r.get("upstream_request_id")}
    # Multiple Claude assistant content blocks describe one provider message.
    # Keep its latest usage snapshot; equal token tuples alone are never identity.
    native_messages = {}
    for row in records:
        if row.get("via") == "direct" and row.get("native_message_id"):
            key = (row.get("client"), row.get("session"), row["native_message_id"])
            previous = native_messages.get(key)
            if previous is None or (row.get("ts") or "") >= (previous.get("ts") or ""):
                native_messages[key] = row
    seen = set()
    selected = [row for row in records if not (row.get("via") == "direct" and row.get("native_message_id"))
                or native_messages[(row.get("client"), row.get("session"), row["native_message_id"])] is row]
    for row in attribute_routing(selected):
        upstream = row.get("upstream_request_id")
        if row.get("via") != "proxy" and upstream and upstream in proxy_ids:
            continue
        if row.get("via") == "direct" and not upstream and row.get("native_kind") != "codex":
            # Native logs can describe traffic already observed by the proxy.
            # Without a request join, do not add the two sources as unique usage.
            row = dict(row, accounting_status="unreconciled_native")
        identity = row.get("attempt_id") or row.get("request_id") or upstream or row.get("native_message_id")
        if identity:
            key = (row.get("provider"), row.get("account"), row.get("via"), row.get("session") if row.get("native_message_id") else None, identity)
            if key in seen: continue
            seen.add(key)
        yield row

ROLLING_WINDOW_HOURS = 24
_TS_FRACTION = re.compile(r"(\.\d{6})\d+")

def parse_ts(ts):
    """Ledger timestamp -> aware UTC instant. Nanosecond fractions are truncated;
    naive values are taken as UTC. Unparsable values return None."""
    if not isinstance(ts, str) or not ts:
        return None
    try:
        value = datetime.fromisoformat(_TS_FRACTION.sub(r"\1", ts.replace("Z", "+00:00")))
    except (ValueError, TypeError):
        return None
    if value.tzinfo is None:
        value = value.replace(tzinfo=timezone.utc)
    return value.astimezone(timezone.utc)

def utc_now():
    return datetime.now(timezone.utc)

def is_rate_limited(row):
    """HTTP 429 is the provider saying the quota is exhausted; other failures are not."""
    status = row.get("status")
    if isinstance(status, bool):
        return False
    try:
        return int(status) == 429
    except (TypeError, ValueError):
        return False

def rollup(defaults, models, days=30):
    """Day, full current-calendar-month and rolling-24h projections over the preserved ledger.

    `today` and `month` follow the report timezone; `last_24h` is a rolling window of
    wall-clock instants, so it never empties at midnight and is timezone independent.
    """
    from datetime import timedelta
    today = local_day()
    month = today[:7]
    now = utc_now()
    window_start = now - timedelta(hours=ROLLING_WINDOW_HOURS)
    per_day = collections.defaultdict(collections.Counter)
    # `upstream` groups by provider and account: one email can serve several providers,
    # and upstream-key providers are identified by provider alone.
    dims = ("client", "model", "via", "account", "upstream")
    periods = {key: {"total": collections.Counter(), "unreconciled": collections.Counter(),
                     "dims": {dim: collections.defaultdict(collections.Counter) for dim in dims},
                     "latest": {dim: {} for dim in ("account", "upstream")}, "unpriced": collections.Counter()}
               for key in ("today", "month", "last_24h")}

    def add(counter, row, api, marginal, priced, tokens):
        counter["api_micro"] += round(api * 1e6)
        counter["marg_micro"] += round((marginal or 0) * 1e6)
        counter["marg_unknown"] += marginal is None
        counter["api_unknown"] += not priced
        counter["tokens"] += tokens
        counter["requests"] += 1
        counter["failed"] += bool(row.get("failed"))
        counter["rate_limited"] += is_rate_limited(row)
        for field in ("in_uncached", "cache_read", "cache_write", "out_total"):
            counter[field] += row.get(field) or 0

    def group_key(row, dim):
        if dim == "upstream":
            return (row.get("provider") or "?", row.get("account") or "?")
        return row.get(dim) or "?"

    for row in rows_for(None):
        day = local_day(row.get("ts"))
        if not day or day > today:
            continue
        instant = parse_ts(row.get("ts"))
        selected = (("today", day == today), ("month", day.startswith(month + "-")),
                    ("last_24h", instant is not None and instant >= window_start))
        api, marginal, priced = cost(row, defaults, models)
        tokens = sum((row.get(field) or 0) for field in ("in_uncached", "cache_read", "cache_write", "out_total"))
        if row.get("accounting_status") == "unreconciled_native":
            for name, chosen in selected:
                if chosen:
                    add(periods[name]["unreconciled"], row, api, marginal, priced, tokens)
            # The retained observations remain readable via rows_for; neither
            # trends nor ranked unique-usage totals combine them with proxy data.
            continue
        add(per_day[day], row, api, marginal, priced, tokens)
        for name, chosen in selected:
            if not chosen:
                continue
            period = periods[name]
            add(period["total"], row, api, marginal, priced, tokens)
            if not priced and tokens:
                period["unpriced"][row.get("model") or "?"] += tokens
            for dim, groups in period["dims"].items():
                key = group_key(row, dim)
                add(groups[key], row, api, marginal, priced, tokens)
                latest = period["latest"].get(dim)
                if latest is not None and instant is not None and (key not in latest or instant > latest[key]):
                    latest[key] = instant

    def amounts(counter):
        return {"api_equivalent_usd": None if counter["api_unknown"] else counter["api_micro"] / 1e6,
                "priced_api_equivalent_usd": counter["api_micro"] / 1e6,
                "marginal_usd": None if counter["marg_unknown"] else counter["marg_micro"] / 1e6}

    def stamp(value):
        return value.isoformat(timespec="seconds")

    def project(name, label):
        period = periods[name]
        total = period["total"]
        unresolved = period["unreconciled"]
        result = {"date": label, "period": "day" if name == "today" else "month",
                  "period_start": today if name == "today" else month + "-01", "period_end": today,
                  "requests": None if unresolved["requests"] else total["requests"], "failed": total["failed"],
                  "rate_limited": total["rate_limited"],
                  "counts": {field: total[field] for field in ("in_uncached", "cache_read", "cache_write", "out_total")},
                  "tokens_total": None if unresolved["requests"] else total["tokens"], **amounts(total), "unpriced": dict(period["unpriced"]),
                  "reconciliation": {"status": "partial" if unresolved["requests"] else "observations_only",
                      "confirmed_tokens": total["tokens"], "confirmed_requests": total["requests"],
                      "unreconciled_native_observations": unresolved["requests"],
                      "unreconciled_native_token_observations": unresolved["tokens"]}}
        if name == "last_24h":
            result.update(period="rolling_24h", window_hours=ROLLING_WINDOW_HOURS,
                          period_start=stamp(window_start), period_end=stamp(now))
        if unresolved["requests"]:
            result["api_equivalent_usd"] = None
            result["marginal_usd"] = None
        for dim, groups in period["dims"].items():
            latest = period["latest"].get(dim, {})
            entries = []
            for key, value in sorted(groups.items(), key=lambda item: (-item[1]["tokens"], item[0] if isinstance(item[0], tuple) else (item[0],))):
                entry = {"name": key[1] if dim == "upstream" else key, **amounts(value), "tokens": value["tokens"],
                         "requests": value["requests"], "failed": value["failed"], "rate_limited": value["rate_limited"]}
                if dim == "upstream":
                    entry["provider"] = key[0]
                if dim in ("account", "upstream"):
                    entry["last_request_at"] = stamp(latest[key]) if key in latest else None
                entries.append(entry)
            result["by_" + dim] = entries
        return result

    cutoff = (date.fromisoformat(today) - timedelta(days=days)).isoformat()
    return {"generated": stamp(now),
            "today": project("today", today), "month": project("month", month), "last_24h": project("last_24h", today),
            "trend_scope": "confirmed_observations",
            "trend": [{"date": day, **amounts(value), "tokens": value["tokens"]}
                      for day, value in sorted(per_day.items()) if day >= cutoff]}

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--day", default=local_day(), help="YYYY-MM-DD, or 'all'")
    ap.add_argument("--by", default="client", choices=["client", "model", "provider", "account", "via"])
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--rollup", action="store_true", help="full dashboard payload on stdout")
    args = ap.parse_args()

    if args.rollup:
        d, m = load_pricing()
        print(json.dumps(rollup(d, m), ensure_ascii=False))
        return
    day = None if args.day == "all" else args.day

    defaults, models = load_pricing()
    agg = collections.defaultdict(lambda: collections.Counter())
    unpriced = collections.Counter()
    flat = collections.Counter()
    totals = collections.Counter()
    unreconciled = 0

    for r in rows_for(day):
        if r.get("accounting_status") == "unreconciled_native":
            unreconciled += 1
            continue
        # Direct rows carry no provider (the log a row came from does not identify
        # the upstream), so resolve it from the price table by model name.
        if args.by == "provider" and not r.get("provider"):
            r["provider"] = (lookup(r.get("model"), models) or {}).get("provider")
        # cliproxy calls the Anthropic upstream "claude"; keep one name per vendor.
        if args.by == "provider" and r.get("provider") == "claude":
            r["provider"] = "anthropic"
        k = r.get(args.by) or "?"
        a = agg[k]
        a["attempts"] += 1
        a["ok"] += 0 if r.get("failed") else 1
        for f in ("in_uncached", "cache_read", "cache_write", "out_total"):
            a[f] += r.get(f) or 0
        api, marg, priced = cost(r, defaults, models)
        a["api_cents"] += round(api * 100_000)   # micro-dollars, integer-safe
        a["marg_cents"] += round((marg or 0) * 100_000)
        a["marg_unknown"] += 1 if marg is None else 0
        a["api_unknown"] += 1 if not priced else 0
        if not priced:
            tok = sum((r.get(f) or 0) for f in ("in_uncached", "cache_read", "cache_write", "out_total"))
            if tok:
                # A flat-rate model (Ollama Cloud et al.) has an entry but no list
                # price on purpose — that is not an action item, so keep it out of
                # the "go add a price" list.
                if lookup(r.get("model"), models):
                    flat[r.get("model") or "?"] += tok
                else:
                    unpriced[r.get("model") or "?"] += tok
                a["unpriced_tokens"] += tok
        totals["attempts"] += 1

    if args.json:
        out = {
            "day": args.day, "by": args.by,
            "groups": {k: {**dict(v),
                           "api_equivalent_usd": None if v["api_unknown"] else v["api_cents"] / 100_000,
                           "marginal_usd": None if v["marg_unknown"] else v["marg_cents"] / 100_000} for k, v in agg.items()},
            "unpriced_models": dict(unpriced),
            "reconciliation": {"status": "partial" if unreconciled else "observations_only",
                               "unreconciled_native_observations": unreconciled,
                               "groups_scope": "confirmed_observations"},
        }
        print(json.dumps(out, indent=1))
        return

    if not agg:
        if unreconciled:
            print(f"{unreconciled} native observations need reconciliation; unique usage is unknown")
            return
        print(f"no ledger rows for {args.day}")
        return

    hdr = f"{args.by:<16}{'req':>6}{'fail':>6}{'in':>12}{'cache_r':>13}{'cache_w':>12}{'out':>10}{'API $':>10}{'est $*':>9}"
    if unreconciled:
        print(f"Confirmed subtotal only: {unreconciled} native observations may overlap; combined usage is unknown.")
    print(hdr); print("-" * len(hdr))
    for k, v in sorted(agg.items(), key=lambda x: -x[1]["api_cents"]):
        print(f"{k:<16}{v['ok']:>6}{v['attempts']-v['ok']:>6}{v['in_uncached']:>12,}{v['cache_read']:>13,}"
              f"{v['cache_write']:>12,}{v['out_total']:>10,}{v['api_cents']/100_000:>10.2f}{v['marg_cents']/100_000:>9.2f}")
    print("-" * len(hdr))
    t = collections.Counter()
    for v in agg.values(): t.update(v)
    print(f"{'TOTAL':<16}{t['ok']:>6}{t['attempts']-t['ok']:>6}{t['in_uncached']:>12,}{t['cache_read']:>13,}"
          f"{t['cache_write']:>12,}{t['out_total']:>10,}{t['api_cents']/100_000:>10.2f}{t['marg_cents']/100_000:>9.2f}")
    if any(v["marg_unknown"] for v in agg.values()):
        print("* Estimated additional cost is incomplete: account billing mode unknown; displayed amount is a known subtotal, not actual payments.")
    if unpriced:
        print("\nUNPRICED — no entry in pricing.yml, cost unknown (add a verified row):")
        for m, tok in unpriced.most_common():
            print(f"  {m:<28} {tok:>12,} tokens")
    if flat:
        print("\nFlat-rate — priced by subscription, no per-token list price (expected):")
        for m, tok in flat.most_common():
            print(f"  {m:<28} {tok:>12,} tokens")

if __name__ == "__main__":
    sys.exit(main())
