#!/usr/bin/env python3
"""ai-usage-report — turn the token ledger into money.

Ledger rows are facts (tokens); prices live in the vault and are applied here, so
fixing a price re-prices history. Two figures per row:
  api_equivalent — cost at list price (what a subscription earns back)
  marginal       — estimated additional usage (unknown without account billing evidence)
A model absent from pricing.yml is reported as UNPRICED, never as $0. When only an
earlier version of the same family and tier has a price, its cost is reported separately
as ESTIMATED with the source model, and never mixed into the verified figures.
"""
import argparse, glob, json, os, re, sys, collections, sqlite3
from pathlib import Path
from datetime import date, datetime, timezone
from zoneinfo import ZoneInfo

REPORT_TZ = ZoneInfo(os.environ.get("AI_USAGE_TIMEZONE", "Asia/Jerusalem"))

def local_day(ts=None):
    if ts is None:
        return datetime.now(REPORT_TZ).date().isoformat()
    try:
        value = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        if value.tzinfo is None: return ts[:10]
        return value.astimezone(REPORT_TZ).date().isoformat()
    except (ValueError, TypeError): return (ts or "")[:10]

LEDGER_DIR = os.path.expanduser(os.environ.get("AI_USAGE_LEDGER_DIR", "~/.local/state/ai-usage"))
PRICING = os.environ.get("AI_USAGE_PRICING", os.path.expanduser("~/.config/ai-usage/pricing.yml"))
ROUTING_DB = os.environ.get("AI_USAGE_ROUTING_DB")
PROJECTS = os.environ.get("AI_USAGE_PROJECTS", os.path.expanduser("~/.config/ai-usage/projects.json"))
UNASSIGNED = "unassigned"

def load_projects(path=None):
    """Operator rules mapping observations to projects: a JSON list (or {"rules": [...]}) of
    {"project": name, <one or more of> "client", "client_prefix", "host", "account", "provider", "via"}.
    Rules are tried in order; the first whose every condition matches wins. A missing or invalid
    file means no rules, so everything is reported as unassigned rather than guessed."""
    try:
        with open(path or PROJECTS) as fh:
            doc = json.load(fh)
    except (OSError, ValueError):
        return []
    rules = doc.get("rules") if isinstance(doc, dict) else doc
    valid = []
    for rule in rules if isinstance(rules, list) else []:
        if not isinstance(rule, dict) or not isinstance(rule.get("project"), str) or not rule["project"].strip():
            continue
        conditions = {k: rule[k] for k in ("client", "client_prefix", "host", "account", "provider", "via") if isinstance(rule.get(k), str) and rule[k]}
        if conditions:
            valid.append({"project": rule["project"].strip(), **conditions})
    return valid

def project_of(row, rules):
    """First matching rule's project, else "unassigned". Native rows carry the host as the client's
    prefix ("host:App"); proxy rows have no host, so a host condition never matches them."""
    client = row.get("client") or ""
    host = client.split(":", 1)[0] if row.get("via") == "direct" and ":" in client else None
    for rule in rules:
        if "client" in rule and rule["client"] != client: continue
        if "client_prefix" in rule and not client.startswith(rule["client_prefix"]): continue
        if "host" in rule and rule["host"] != host: continue
        if "account" in rule and rule["account"].lower() != (row.get("account") or "").lower(): continue
        if "provider" in rule and rule["provider"] != (row.get("provider") or ""): continue
        if "via" in rule and rule["via"] != (row.get("via") or ""): continue
        return rule["project"]
    return UNASSIGNED

def load_pricing():
    import yaml
    with open(PRICING) as fh:
        doc = yaml.safe_load(fh)
    return doc.get("defaults", {}), doc.get("models", {})

_SNAPSHOT_DATE = re.compile(r"-\d{8}$")
_VERSION_SEGMENT = re.compile(r"^\d+(?:\.\d+)*$")

def route_prefixes(defaults):
    """Prefixes the operator declared as pure routing labels (`defaults.route_prefixes`).

    Nothing is stripped by default: `fw-*` and `vendor/model` ids name route-specific
    prices, so a prefix is only dropped when the price table says it carries no price."""
    values = (defaults or {}).get("route_prefixes") if isinstance(defaults, dict) else None
    return tuple(value for value in values if isinstance(value, str) and value) if isinstance(values, list) else ()

def alias_ids(model, prefixes=()):
    """Normalized forms of a logged id that denote the same priced model, most specific first.

    Ollama-style variant suffixes (glm-5.2:cloud), declared route-label prefixes, Anthropic
    dated snapshots (claude-opus-4-5-20251101) and proxy "-thinking" routes
    (claude-opus-4-6-thinking: thinking is billed as output tokens of the same model)."""
    name = model.split(":", 1)[0]
    forms = [name]
    for prefix in prefixes:
        if name.startswith(prefix) and len(name) > len(prefix):
            name = name[len(prefix):]
            forms.append(name)
            break
    for pattern in (_SNAPSHOT_DATE, re.compile(r"-thinking$"), _SNAPSHOT_DATE):
        name = pattern.sub("", name)
        forms.append(name)
    unique = []
    for form in forms:
        if form and form != model and form not in unique:
            unique.append(form)
    return unique

def _entry(models, key):
    value = models.get(key)
    return value if isinstance(value, dict) and value else None

def has_list_price(entry):
    return all(isinstance(entry.get(field), (int, float)) and not isinstance(entry.get(field), bool) for field in ("in", "out"))

def version_stem(model):
    """Family-and-tier stem and version of an id: the first run of numeric segments is the version.

    claude-opus-4-5 -> ("claude-opus-{v}", (4, 5)); gpt-6.1-sol -> ("gpt-{v}-sol", (6, 1)).
    Tiers stay in the stem (opus/fable/sonnet, sol/luna/astra), so they never mix. None
    when the id has no version run (kimi-k3, gpt-oss-120b)."""
    parts = model.split("-")
    for start, part in enumerate(parts):
        if _VERSION_SEGMENT.match(part):
            end = start
            while end < len(parts) and _VERSION_SEGMENT.match(parts[end]):
                end += 1
            version = tuple(int(number) for segment in parts[start:end] for number in segment.split("."))
            return "-".join(parts[:start] + ["{v}"] + parts[end:]), version
    return None

def previous_version(model, models):
    """Key of the nearest lower version with the same stem and a list price, or None.

    Only rows with a numeric price qualify, and never a newer version: an estimate
    from the predecessor is a guess, not a bound (successors are often cheaper)."""
    parsed = version_stem(model)
    if not parsed:
        return None
    stem, version = parsed
    best = None
    for key, entry in models.items():
        if not isinstance(key, str) or not isinstance(entry, dict) or "alias_of" in entry or not has_list_price(entry):
            continue
        candidate = version_stem(_SNAPSHOT_DATE.sub("", key.split(":", 1)[0]))
        if not candidate or candidate[0] != stem or candidate[1] >= version:
            continue
        rank = (candidate[1], -len(key), key)  # the undated row wins a tie with its snapshot
        if best is None or rank > best[0]:
            best = (rank, key)
    return best[1] if best else None

def resolve_price(model, models, prefixes=()):
    """Price-table row for a logged model id -> (entry, basis, source key).

    basis "exact"      the id's own row
          "alias"      the row of a normalized id (alias_ids) or of an explicit `alias_of:` target
          "estimated"  no row exists for the id or any alias: the nearest previous version of the
                       same family and tier that has a list price (previous_version)
          None         unknown; never $0
    An existing row always wins, including one without a list price (in: null, flat rate):
    a deliberate "no price" is never replaced by an estimate."""
    if not model or not isinstance(model, str) or not isinstance(models, dict):
        return None, None, None
    candidates = [model] + alias_ids(model, prefixes)
    for key in candidates:
        entry = _entry(models, key)
        if entry is None:
            continue
        basis, seen = "exact" if key == model else "alias", {key}
        while isinstance(entry.get("alias_of"), str):
            key = entry["alias_of"]
            entry = _entry(models, key)
            if entry is None or key in seen:
                return None, None, None  # a broken or circular alias prices nothing
            seen.add(key)
            basis = "alias"
        return entry, basis, key
    source = previous_version(candidates[-1], models)
    return (models[source], "estimated", source) if source else (None, None, None)

def lookup(model, models, prefixes=()):
    """The row that prices `model` verbatim or through an alias; None when only an estimate exists."""
    entry, basis, _ = resolve_price(model, models, prefixes)
    return entry if basis in ("exact", "alias") else None

def list_cost(p, row, defaults):
    """API-equivalent USD of one row at entry `p`'s list price, or None when `p` has no list
    price or the row lacks the evidence its context tier needs."""
    if not p or p.get("in") is None:
        return None
    tier = p.get("long_context")
    if tier is not None:
        # Context is the complete prompt, including cached input, never output.
        # Require every bucket: missing evidence cannot establish the price tier.
        inputs = [row.get(field) for field in ("in_uncached", "cache_read", "cache_write")]
        threshold = tier.get("input_tokens_above") if isinstance(tier, dict) else None
        if (not isinstance(threshold, int) or isinstance(threshold, bool) or threshold < 0
                or any(not isinstance(value, int) or isinstance(value, bool) or value < 0 for value in inputs)):
            return None
        if sum(inputs) > threshold:
            # Long-context rates apply to all buckets and output, not just overflow.
            p = {**p, **tier}
            if tier.get("in") is None or tier.get("out") is None:
                return None
    # Per-model overrides matter across providers: Anthropic charges 1.25x for a
    # cache write, OpenAI and Moonshot do not charge for one at all, and cache-read
    # rates differ per model (Opus 5.5 0.05x, Fable 5.1 0.025x).
    cw = p.get("cache_write_multiplier", defaults.get("cache_write_multiplier", 1.25))
    cr = p.get("cache_read_multiplier", defaults.get("cache_read_multiplier", 0.1))
    pin, pout = float(p["in"]), float(p["out"])
    return (
        (row.get("in_uncached") or 0) / 1e6 * pin
        + (row.get("cache_read") or 0) / 1e6 * pin * cr
        + (row.get("cache_write") or 0) / 1e6 * pin * cw
        + (row.get("out_total") or 0) / 1e6 * pout
    )

def price_row(row, defaults, models, resolved=None):
    """-> (api_equivalent_usd, marginal_usd, priced?, estimated_usd, estimated_from)

    `priced` means a verified price (exact or alias). A lineage estimate is reported beside
    it as (estimated_usd, source model) and never enters api_equivalent_usd. `resolved`
    is an optional per-call cache of model -> resolve_price()."""
    model = row.get("model")
    if resolved is None or model not in resolved:
        found = resolve_price(model, models, route_prefixes(defaults))
        if resolved is None:
            resolved = {}
        resolved[model] = found
    entry, basis, source = resolved[model]
    api = list_cost(entry, row, defaults)
    if api is None:
        return 0.0, None, False, None, None  # caller separates "no entry" from "flat rate, no list price"
    if basis == "estimated":
        return 0.0, None, False, api, source
    mode = row.get("billing_mode")
    # A model can exist on subscription and paid accounts: never classify by model.
    marginal = 0.0 if mode == "included" else api if mode == "metered" else None
    return api, marginal, True, None, None

def cost(row, defaults, models):
    """-> (api_equivalent_usd, marginal_usd, priced?) at a verified price; an estimate is never priced."""
    return price_row(row, defaults, models)[:3]

def attribute_routing(records):
    """Enrich the read projection only, using exact managed attempt/request IDs."""
    managed = [row for row in records if row.get("attempt_id") or row.get("managed_request_id")]
    if not managed:
        return records
    matches = {}
    by_request = collections.defaultdict(list)
    status = "unconfigured" if not ROUTING_DB else "unavailable"
    if ROUTING_DB:
        try:
            # mode=ro never creates a missing database or modifies gateway state.
            uri = Path(ROUTING_DB).expanduser().resolve().as_uri() + "?mode=ro"
            db = sqlite3.connect(uri, uri=True, timeout=1)
            try:
                db.row_factory = sqlite3.Row
                db.execute("PRAGMA query_only=ON")
                attempt_ids = {r["attempt_id"] for r in managed if r.get("attempt_id")}
                request_ids = {r["managed_request_id"] for r in managed if not r.get("attempt_id") and r.get("managed_request_id")}
                for field, identifiers in (("id", attempt_ids), ("request_id", request_ids)):
                    identifiers = sorted(identifiers)
                    for start in range(0, len(identifiers), 400):
                        batch = identifiers[start:start + 400]
                        query = ("SELECT id,request_id,client_id,session_id,role,account_id,billing,"
                                 "model,policy_version,fallback_reason FROM attempts WHERE " + field
                                 + " IN (" + ",".join("?" for _ in batch) + ")")
                        for result in db.execute(query, batch):
                            matches[result["id"]] = dict(result)
                for result in matches.values():
                    by_request[result["request_id"]].append(result)
                status = "unmatched"
            finally:
                db.close()
        except (sqlite3.Error, OSError, ValueError):
            matches.clear()
            by_request.clear()
            print("Routing attribution unavailable; preserving original ledger metadata", file=sys.stderr)
    projected = []
    for original in records:
        if not (original.get("attempt_id") or original.get("managed_request_id")):
            projected.append(original)
            continue
        row = dict(original, routing_attribution=status)
        attempt = matches.get(row.get("attempt_id"))
        if not row.get("attempt_id") and row.get("managed_request_id"):
            candidates = by_request[row["managed_request_id"]]
            if len(candidates) == 1:
                attempt = candidates[0]
            elif len(candidates) > 1:
                row["routing_attribution"] = "ambiguous"
        if attempt and row.get("managed_request_id") not in (None, "", attempt["request_id"]):
            row["routing_attribution"] = "id-mismatch"
            attempt = None
        if attempt:
            row.update(client=attempt["client_id"], account=attempt["account_id"],
                       attempt_id=attempt["id"], managed_request_id=attempt["request_id"],
                       session_id=attempt["session_id"], role=attempt["role"],
                       routing_model=attempt["model"], policy_version=attempt["policy_version"],
                       fallback_reason=attempt["fallback_reason"], routing_attribution="joined")
            mode = {"included": "included", "paid": "metered"}.get(attempt["billing"])
            if mode:
                row["billing_mode"] = mode
        projected.append(row)
    return projected

FINGERPRINT_WINDOW_SECONDS = 600

def base_model(model):
    return re.sub(r"-\d{8}$", "", (model or "").split(":", 1)[0])

def fingerprint(row):
    """Model plus the four token buckets. All-zero tuples carry no identity and never match."""
    key = (base_model(row.get("model")),) + tuple(row.get(field) or 0 for field in ("in_uncached", "cache_read", "cache_write", "out_total"))
    return key if any(key[1:]) else None

def matches_proxy(row, proxy_prints):
    """True when a proxy row with the same fingerprint was observed within the window.
    The nearest candidate is consumed, so one proxy observation explains one native row."""
    key = fingerprint(row)
    instant = parse_ts(row.get("ts"))
    candidates = proxy_prints.get(key) if key and instant else None
    if not candidates:
        return False
    nearest = min(range(len(candidates)), key=lambda index: abs((candidates[index] - instant).total_seconds()))
    if abs((candidates[nearest] - instant).total_seconds()) > FINGERPRINT_WINDOW_SECONDS:
        return False
    del candidates[nearest]
    return True

def rows_for(day):
    # Preserve raw ledger; reconcile observations in the read projection only.
    if not os.path.isdir(LEDGER_DIR):
        raise FileNotFoundError('Token ledger source is unavailable')
    records = []
    for path in sorted(glob.glob(os.path.join(LEDGER_DIR, "ledger-*.jsonl"))):
        with open(path) as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if day and local_day(row.get("ts")) != day:
                    continue
                records.append(row)
    # Proxy observation is preferred for matched native observations because it
    # carries selected account/attempt metadata. Do not merge separate attempts.
    proxy_ids = {r.get("upstream_request_id") for r in records if r.get("via") == "proxy" and r.get("upstream_request_id")}
    proxy_prints = collections.defaultdict(list)
    for r in records:
        if r.get("via") == "proxy":
            print_key, instant = fingerprint(r), parse_ts(r.get("ts"))
            if print_key and instant:
                proxy_prints[print_key].append(instant)
    # Multiple Claude assistant content blocks describe one provider message.
    # Keep its latest usage snapshot; equal token tuples alone are never identity.
    native_messages = {}
    for row in records:
        if row.get("via") == "direct" and row.get("native_message_id"):
            key = (row.get("client"), row.get("session"), row["native_message_id"])
            previous = native_messages.get(key)
            if previous is None or (row.get("ts") or "") >= (previous.get("ts") or ""):
                native_messages[key] = row
    seen = set()
    selected = [row for row in records if not (row.get("via") == "direct" and row.get("native_message_id"))
                or native_messages[(row.get("client"), row.get("session"), row["native_message_id"])] is row]
    for row in attribute_routing(selected):
        upstream = row.get("upstream_request_id")
        if row.get("via") != "proxy" and upstream and upstream in proxy_ids:
            continue
        if row.get("via") == "direct" and row.get("native_kind") != "codex" and (not upstream or upstream not in proxy_ids):
            # Native logs can describe traffic already observed by the proxy, and current
            # Claude Code logs carry no request id. A proxy row with the same model and token
            # tuple minutes apart is that observation: keep the proxy row, which names the
            # credential that served it.
            if matches_proxy(row, proxy_prints):
                continue
            if not row.get("account"):
                # Without a join and without the signed-in identity the row cannot be placed.
                row = dict(row, accounting_status="unreconciled_native")
        identity = row.get("attempt_id") or row.get("request_id") or upstream or row.get("native_message_id")
        if identity:
            key = (row.get("provider"), row.get("account"), row.get("via"), row.get("session") if row.get("native_message_id") else None, identity)
            if key in seen: continue
            seen.add(key)
        yield row

ROLLING_WINDOW_HOURS = 24
_TS_FRACTION = re.compile(r"(\.\d{6})\d+")

def parse_ts(ts):
    """Ledger timestamp -> aware UTC instant. Nanosecond fractions are truncated;
    naive values are taken as UTC. Unparsable values return None."""
    if not isinstance(ts, str) or not ts:
        return None
    try:
        value = datetime.fromisoformat(_TS_FRACTION.sub(r"\1", ts.replace("Z", "+00:00")))
    except (ValueError, TypeError):
        return None
    if value.tzinfo is None:
        value = value.replace(tzinfo=timezone.utc)
    return value.astimezone(timezone.utc)

def utc_now():
    return datetime.now(timezone.utc)

def is_rate_limited(row):
    """HTTP 429 is the provider saying the quota is exhausted; other failures are not."""
    status = row.get("status")
    if isinstance(status, bool):
        return False
    try:
        return int(status) == 429
    except (TypeError, ValueError):
        return False

def rollup(defaults, models, days=30, projects=None):
    """Day, full current-calendar-month and rolling-24h projections over the preserved ledger.

    `today` and `month` follow the report timezone; `last_24h` is a rolling window of
    wall-clock instants, so it never empties at midnight and is timezone independent.
    """
    from datetime import timedelta
    today = local_day()
    month = today[:7]
    now = utc_now()
    window_start = now - timedelta(hours=ROLLING_WINDOW_HOURS)
    per_day = collections.defaultdict(collections.Counter)
    # `upstream` groups by provider and account: one email can serve several providers,
    # and upstream-key providers are identified by provider alone.
    dims = ("client", "model", "via", "account", "upstream", "project")
    rules = load_projects() if projects is None else projects
    periods = {key: {"total": collections.Counter(), "unreconciled": collections.Counter(),
                     "dims": {dim: collections.defaultdict(collections.Counter) for dim in dims},
                     "latest": {dim: {} for dim in ("account", "upstream")}, "unpriced": collections.Counter(),
                     "estimated": collections.defaultdict(collections.Counter), "estimated_from": {},
                     "group_estimates": {dim: collections.defaultdict(dict) for dim in dims}}
               for key in ("today", "month", "last_24h")}
    resolved = {}

    def add(counter, row, api, marginal, priced, tokens, estimated=None):
        counter["api_micro"] += round(api * 1e6)
        counter["marg_micro"] += round((marginal or 0) * 1e6)
        counter["marg_unknown"] += marginal is None
        # A row without billable tokens costs nothing at any price (failed probes, 404s):
        # only billable tokens without a verified price leave the API-equivalent unknown.
        unverified = not priced and tokens > 0
        counter["api_unknown"] += unverified
        if unverified and estimated is not None:
            counter["est_micro"] += round(estimated * 1e6)
            counter["est_requests"] += 1
        elif unverified:
            counter["unpriced_requests"] += 1
        counter["tokens"] += tokens
        counter["requests"] += 1
        counter["failed"] += bool(row.get("failed"))
        counter["rate_limited"] += is_rate_limited(row)
        for field in ("in_uncached", "cache_read", "cache_write", "out_total"):
            counter[field] += row.get(field) or 0

    def group_key(row, dim):
        if dim == "upstream":
            return (row.get("provider") or "?", row.get("account") or "?")
        if dim == "project":
            return project_of(row, rules)
        return row.get(dim) or "?"

    for row in rows_for(None):
        day = local_day(row.get("ts"))
        if not day or day > today:
            continue
        instant = parse_ts(row.get("ts"))
        selected = (("today", day == today), ("month", day.startswith(month + "-")),
                    ("last_24h", instant is not None and instant >= window_start))
        api, marginal, priced, estimated, source = price_row(row, defaults, models, resolved)
        tokens = sum((row.get(field) or 0) for field in ("in_uncached", "cache_read", "cache_write", "out_total"))
        if row.get("accounting_status") == "unreconciled_native":
            for name, chosen in selected:
                if chosen:
                    add(periods[name]["unreconciled"], row, api, marginal, priced, tokens, estimated)
            # The retained observations remain readable via rows_for; neither
            # trends nor ranked unique-usage totals combine them with proxy data.
            continue
        add(per_day[day], row, api, marginal, priced, tokens, estimated)
        model = row.get("model") or "?"
        for name, chosen in selected:
            if not chosen:
                continue
            period = periods[name]
            add(period["total"], row, api, marginal, priced, tokens, estimated)
            # `unpriced` keeps its meaning (no verified price); `estimated` is the subset
            # an earlier version could cost, with the model that supplied the price.
            if not priced and tokens:
                period["unpriced"][model] += tokens
                if estimated is not None:
                    period["estimated"][model]["tokens"] += tokens
                    period["estimated"][model]["micro"] += round(estimated * 1e6)
                    period["estimated_from"][model] = source
            for dim, groups in period["dims"].items():
                key = group_key(row, dim)
                add(groups[key], row, api, marginal, priced, tokens, estimated)
                if estimated is not None and not priced and tokens:
                    period["group_estimates"][dim][key][model] = source
                latest = period["latest"].get(dim)
                if latest is not None and instant is not None and (key not in latest or instant > latest[key]):
                    latest[key] = instant

    def amounts(counter):
        # api_equivalent_usd / priced_api_equivalent_usd stay verified-only; an estimate is
        # its own figure, and unpriced_requests counts billable rows with no price at all.
        return {"api_equivalent_usd": None if counter["api_unknown"] else counter["api_micro"] / 1e6,
                "priced_api_equivalent_usd": counter["api_micro"] / 1e6,
                "estimated_api_equivalent_usd": counter["est_micro"] / 1e6 if counter["est_requests"] else None,
                "unpriced_requests": counter["unpriced_requests"],
                "marginal_usd": None if counter["marg_unknown"] else counter["marg_micro"] / 1e6}

    def stamp(value):
        return value.isoformat(timespec="seconds")

    def project(name, label):
        period = periods[name]
        total = period["total"]
        unresolved = period["unreconciled"]
        result = {"date": label, "period": "day" if name == "today" else "month",
                  "period_start": today if name == "today" else month + "-01", "period_end": today,
                  "requests": None if unresolved["requests"] else total["requests"], "failed": total["failed"],
                  "rate_limited": total["rate_limited"],
                  "counts": {field: total[field] for field in ("in_uncached", "cache_read", "cache_write", "out_total")},
                  "tokens_total": None if unresolved["requests"] else total["tokens"], **amounts(total), "unpriced": dict(period["unpriced"]),
                  "estimated": {model: {"tokens": value["tokens"], "usd": value["micro"] / 1e6, "from": period["estimated_from"][model]}
                                for model, value in sorted(period["estimated"].items())},
                  "reconciliation": {"status": "partial" if unresolved["requests"] else "observations_only",
                      "confirmed_tokens": total["tokens"], "confirmed_requests": total["requests"],
                      "unreconciled_native_observations": unresolved["requests"],
                      "unreconciled_native_token_observations": unresolved["tokens"]}}
        if name == "last_24h":
            result.update(period="rolling_24h", window_hours=ROLLING_WINDOW_HOURS,
                          period_start=stamp(window_start), period_end=stamp(now))
        if unresolved["requests"]:
            result["api_equivalent_usd"] = None
            result["marginal_usd"] = None
        projects_dim = period["dims"]["project"]
        result["attribution"] = {"rules": len(rules), "assigned_requests": sum(v["requests"] for k, v in projects_dim.items() if k != UNASSIGNED),
                                 "unassigned_requests": projects_dim[UNASSIGNED]["requests"] if UNASSIGNED in projects_dim else 0}
        for dim, groups in period["dims"].items():
            latest = period["latest"].get(dim, {})
            entries = []
            for key, value in sorted(groups.items(), key=lambda item: (-item[1]["tokens"], item[0] if isinstance(item[0], tuple) else (item[0],))):
                entry = {"name": key[1] if dim == "upstream" else key, **amounts(value), "tokens": value["tokens"],
                         "requests": value["requests"], "failed": value["failed"], "rate_limited": value["rate_limited"]}
                if dim == "upstream":
                    entry["provider"] = key[0]
                if dim in ("account", "upstream"):
                    entry["last_request_at"] = stamp(latest[key]) if key in latest else None
                sources = period["group_estimates"][dim].get(key)
                if sources:
                    entry["estimated_from"] = dict(sorted(sources.items()))
                entries.append(entry)
            result["by_" + dim] = entries
        return result

    cutoff = (date.fromisoformat(today) - timedelta(days=days)).isoformat()
    return {"generated": stamp(now),
            "today": project("today", today), "month": project("month", month), "last_24h": project("last_24h", today),
            "trend_scope": "confirmed_observations",
            "trend": [{"date": day, **amounts(value), "tokens": value["tokens"]}
                      for day, value in sorted(per_day.items()) if day >= cutoff]}

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--day", default=local_day(), help="YYYY-MM-DD, or 'all'")
    ap.add_argument("--by", default="client", choices=["client", "model", "provider", "account", "via", "project"])
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--rollup", action="store_true", help="full dashboard payload on stdout")
    args = ap.parse_args()

    if args.rollup:
        d, m = load_pricing()
        print(json.dumps(rollup(d, m), ensure_ascii=False))
        return
    day = None if args.day == "all" else args.day

    defaults, models = load_pricing()
    prefixes = route_prefixes(defaults)
    rules = load_projects()
    agg = collections.defaultdict(lambda: collections.Counter())
    unpriced = collections.Counter()
    flat = collections.Counter()
    estimated = collections.defaultdict(collections.Counter)
    estimated_from = {}
    resolved = {}

    def resolution(model):
        if model not in resolved:
            resolved[model] = resolve_price(model, models, prefixes)
        return resolved[model]
    totals = collections.Counter()
    unreconciled = 0

    for r in rows_for(day):
        if r.get("accounting_status") == "unreconciled_native":
            unreconciled += 1
            continue
        # Direct rows carry no provider (the log a row came from does not identify
        # the upstream), so resolve it from the price table by model name.
        if args.by == "provider" and not r.get("provider"):
            # An estimate's source is the same family, hence the same vendor.
            r["provider"] = (resolution(r.get("model"))[0] or {}).get("provider")
        # cliproxy calls the Anthropic upstream "claude"; keep one name per vendor.
        if args.by == "provider" and r.get("provider") == "claude":
            r["provider"] = "anthropic"
        k = project_of(r, rules) if args.by == "project" else (r.get(args.by) or "?")
        a = agg[k]
        a["attempts"] += 1
        a["ok"] += 0 if r.get("failed") else 1
        for f in ("in_uncached", "cache_read", "cache_write", "out_total"):
            a[f] += r.get(f) or 0
        api, marg, priced, est, source = price_row(r, defaults, models, resolved)
        tok = sum((r.get(f) or 0) for f in ("in_uncached", "cache_read", "cache_write", "out_total"))
        a["api_cents"] += round(api * 100_000)   # integer-safe hundred-thousandths of a dollar
        a["marg_cents"] += round((marg or 0) * 100_000)
        a["marg_unknown"] += 1 if marg is None else 0
        # Zero-token rows (failed probes) cost nothing at any price.
        a["api_unknown"] += 1 if not priced and tok else 0
        if not priced and tok:
            # A flat-rate model (Ollama Cloud et al.) has an entry but no list
            # price on purpose — that is not an action item, so keep it out of
            # the "go add a price" list.
            if resolution(r.get("model"))[1] in ("exact", "alias"):
                flat[r.get("model") or "?"] += tok
            else:
                unpriced[r.get("model") or "?"] += tok
                if est is not None:
                    a["est_cents"] += round(est * 100_000)
                    a["est_rows"] += 1
                    estimated[r.get("model") or "?"]["tokens"] += tok
                    estimated[r.get("model") or "?"]["cents"] += round(est * 100_000)
                    estimated_from[r.get("model") or "?"] = source
            a["unpriced_tokens"] += tok
        totals["attempts"] += 1

    if args.json:
        out = {
            "day": args.day, "by": args.by,
            "groups": {k: {**dict(v),
                           "api_equivalent_usd": None if v["api_unknown"] else v["api_cents"] / 100_000,
                           "estimated_api_equivalent_usd": v["est_cents"] / 100_000 if v["est_rows"] else None,
                           "marginal_usd": None if v["marg_unknown"] else v["marg_cents"] / 100_000} for k, v in agg.items()},
            "unpriced_models": dict(unpriced),
            # Subset of unpriced_models costed at an earlier version's list price; not verified.
            "estimated_models": {m: {"tokens": v["tokens"], "usd": v["cents"] / 100_000, "from": estimated_from[m]}
                                 for m, v in sorted(estimated.items())},
            "reconciliation": {"status": "partial" if unreconciled else "observations_only",
                               "unreconciled_native_observations": unreconciled,
                               "groups_scope": "confirmed_observations"},
        }
        print(json.dumps(out, indent=1))
        return

    if not agg:
        if unreconciled:
            print(f"{unreconciled} native observations need reconciliation; unique usage is unknown")
            return
        print(f"no ledger rows for {args.day}")
        return

    hdr = f"{args.by:<16}{'req':>6}{'fail':>6}{'in':>12}{'cache_r':>13}{'cache_w':>12}{'out':>10}{'API $':>10}{'est $*':>9}"
    if unreconciled:
        print(f"Confirmed subtotal only: {unreconciled} native observations may overlap; combined usage is unknown.")
    print(hdr); print("-" * len(hdr))
    for k, v in sorted(agg.items(), key=lambda x: -x[1]["api_cents"]):
        print(f"{k:<16}{v['ok']:>6}{v['attempts']-v['ok']:>6}{v['in_uncached']:>12,}{v['cache_read']:>13,}"
              f"{v['cache_write']:>12,}{v['out_total']:>10,}{v['api_cents']/100_000:>10.2f}{v['marg_cents']/100_000:>9.2f}")
    print("-" * len(hdr))
    t = collections.Counter()
    for v in agg.values(): t.update(v)
    print(f"{'TOTAL':<16}{t['ok']:>6}{t['attempts']-t['ok']:>6}{t['in_uncached']:>12,}{t['cache_read']:>13,}"
          f"{t['cache_write']:>12,}{t['out_total']:>10,}{t['api_cents']/100_000:>10.2f}{t['marg_cents']/100_000:>9.2f}")
    if any(v["marg_unknown"] for v in agg.values()):
        print("* Estimated additional cost is incomplete: account billing mode unknown; displayed amount is a known subtotal, not actual payments.")
    if estimated:
        print("\nESTIMATED — no verified price; costed at an earlier version's list price, not in API $ (add a verified row):")
        for m, v in sorted(estimated.items(), key=lambda item: -item[1]["tokens"]):
            print(f"  {m:<28} {v['tokens']:>12,} tokens  ~${v['cents']/100_000:,.2f} from {estimated_from[m]}")
    if set(unpriced) - set(estimated):
        print("\nUNPRICED — no entry in pricing.yml, cost unknown (add a verified row):")
        for m, tok in unpriced.most_common():
            if m not in estimated:
                print(f"  {m:<28} {tok:>12,} tokens")
    if flat:
        print("\nFlat-rate — priced by subscription, no per-token list price (expected):")
        for m, tok in flat.most_common():
            print(f"  {m:<28} {tok:>12,} tokens")

if __name__ == "__main__":
    sys.exit(main())
