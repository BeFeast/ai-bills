#!/usr/bin/env python3
"""Validate stdin and atomically replace one operator-selected snapshot file."""
import json
import os
import sys
import tempfile
from pathlib import Path


def receive(destination, stream):
    target = Path(destination)
    raw = stream.read(32 * 1024 * 1024 + 1)
    if len(raw) > 32 * 1024 * 1024:
        raise ValueError('snapshot too large')
    value = json.loads(raw)
    if not isinstance(value, dict) or not isinstance(value.get('generated'), str):
        raise ValueError('invalid snapshot envelope')
    # Destination directory/ownership are provisioned explicitly by the operator.
    fd, name = tempfile.mkstemp(prefix='.snapshot-', dir=target.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            output.write(raw)
            output.flush()
            os.fsync(output.fileno())
        if target.exists():
            previous = target.stat()
            os.chmod(name, previous.st_mode & 0o777)
            if os.geteuid() == 0:
                os.chown(name, previous.st_uid, previous.st_gid)
        os.replace(name, target)
        directory = os.open(target.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise ValueError('destination argument required')
        receive(sys.argv[1], sys.stdin)
    except Exception:
        print('Snapshot rejected; previous file retained unless replacement already completed', file=sys.stderr)
        sys.exit(1)
