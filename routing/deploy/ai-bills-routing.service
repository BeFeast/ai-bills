[Unit]
Description=AI Bills routing and strict paid admission
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-bills-routing
Group=ai-bills-routing
WorkingDirectory=/opt/ai-bills-routing/routing
EnvironmentFile=/etc/ai-bills-routing/runtime.env
ExecStart=/opt/ai-bills-routing/routing/.venv/bin/python server.py --config /etc/ai-bills-routing/runtime.json
Restart=on-failure
RestartSec=5
StateDirectory=ai-bills-routing
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/ai-bills-routing
ReadWritePaths=/var/lib/ai-bills-routing

[Install]
WantedBy=multi-user.target
