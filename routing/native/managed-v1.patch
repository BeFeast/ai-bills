+++ b/internal/runtime/executor/managed_executor.go
@@ -0,0 +1,17 @@
+package executor
+
+import auth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+
+func (e *OpenAICompatExecutor) ManagedHTTPExecutor() auth.ProviderExecutor { return e }
+func (e *ClaudeExecutor) ManagedHTTPExecutor() auth.ProviderExecutor       { return e }
+func (e *CodexExecutor) ManagedHTTPExecutor() auth.ProviderExecutor        { return e }
+func (e *CodexAutoExecutor) ManagedHTTPExecutor() auth.ProviderExecutor    { return e.httpExec }
+
+// Embedded CodexExecutor must never implicitly opt its websocket wrapper in.
+func (e *CodexWebsocketsExecutor) ManagedHTTPExecutor() auth.ProviderExecutor { return e.CodexExecutor }
+
+// Kimi embeds ClaudeExecutor but must retain its own endpoint/model semantics.
+func (e *KimiExecutor) ManagedHTTPExecutor() auth.ProviderExecutor { return e }
+func (e *KimiExecutor) ManagedCanonicalModel(model string) string {
+	return normalizeKimiUpstreamModel(model)
+}
