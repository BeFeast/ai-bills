+package helps
+
+import (
+	"context"
+	"encoding/json"
+	codexchat "github.com/router-for-me/CLIProxyAPI/v7/internal/translator/codex/openai/chat-completions"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// ManagedChatToResponses reuses structural messages/tools conversion, then removes
+// Codex-only defaults and restores generic Responses generation parameters.
+func ManagedChatToResponses(model string, raw []byte, stream bool) []byte {
+	out := codexchat.ConvertOpenAIRequestToCodex(model, raw, stream)
+	for _, key := range []string{"include", "parallel_tool_calls", "store"} {
+		out, _ = sjson.DeleteBytes(out, key)
+		if v := gjson.GetBytes(raw, key); v.Exists() {
+			out, _ = sjson.SetRawBytes(out, key, []byte(v.Raw))
+		}
+	}
+	if !gjson.GetBytes(raw, "reasoning_effort").Exists() {
+		out, _ = sjson.DeleteBytes(out, "reasoning.effort")
+	}
+	for _, key := range []string{"temperature", "top_p", "service_tier", "n", "best_of"} {
+		if v := gjson.GetBytes(raw, key); v.Exists() {
+			out, _ = sjson.SetRawBytes(out, key, []byte(v.Raw))
+		}
+	}
+	for _, key := range []string{"max_tokens", "max_completion_tokens", "max_output_tokens"} {
+		if v := gjson.GetBytes(raw, key); v.Exists() {
+			out, _ = sjson.SetRawBytes(out, "max_output_tokens", []byte(v.Raw))
+		}
+	}
+	return out
+}
+func ManagedResponsesToChat(ctx context.Context, model string, original, request, body []byte, param *any) []byte {
+	wrapped, _ := json.Marshal(map[string]any{"type": "response.completed", "response": json.RawMessage(body)})
+	return codexchat.ConvertCodexResponseToOpenAINonStream(ctx, model, original, request, wrapped, param)
+}
+func ManagedResponsesToChatStream(ctx context.Context, model string, original, request, line []byte, param *any) [][]byte {
+	return codexchat.ConvertCodexResponseToOpenAI(ctx, model, original, request, line, param)
+}
