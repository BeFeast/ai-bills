diff --git a/sdk/cliproxy/auth/managed_execution.go b/sdk/cliproxy/auth/managed_execution.go
new file mode 100644
index 0000000..a1498ee
--- /dev/null
+++ b/sdk/cliproxy/auth/managed_execution.go
@@ -0,0 +1,113 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	ex "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/managed"
+)
+
+// ManagedHTTPExecutor opts in only audited HTTP generation implementations.
+type ManagedHTTPExecutor interface{ ManagedHTTPExecutor() ProviderExecutor }
+type managedCanonicalModel interface{ ManagedCanonicalModel(string) string }
+
+func (m *Manager) managedSelection(ctx context.Context, req ex.Request, opts ex.Options) (ProviderExecutor, *Auth, error) {
+	a := managed.From(ctx)
+	if a == nil || !a.Claim() {
+		return nil, nil, managed.ErrReplay
+	}
+	auth, ok := m.GetByID(a.AuthID)
+	if !ok || auth.Disabled {
+		return nil, nil, fmt.Errorf("managed account unavailable")
+	}
+	executor := m.executorFor(executorKeyFromAuth(auth))
+	supported, ok := executor.(ManagedHTTPExecutor)
+	if !ok {
+		return nil, nil, fmt.Errorf("managed single-attempt executor unsupported")
+	}
+	executor = supported.ManagedHTTPExecutor()
+	if executor == nil {
+		return nil, nil, fmt.Errorf("managed executor unavailable")
+	}
+	if !registry.GetGlobalRegistry().ClientSupportsModel(auth.ID, req.Model) {
+		return nil, nil, fmt.Errorf("managed exact model not registered for account")
+	}
+	if err := managed.RequireAccount(ctx, auth.ID); err != nil {
+		return nil, nil, err
+	}
+	candidates, _, _, _ := m.executionModelCandidatesWithAlias(auth, req.Model)
+	canonical := a.UpstreamModel
+	if canonical == "" {
+		canonical = req.Model
+		if normalizer, ok := executor.(managedCanonicalModel); ok {
+			canonical = normalizer.ManagedCanonicalModel(canonical)
+		}
+	}
+	found := false
+	for _, candidate := range candidates {
+		if normalizer, ok := executor.(managedCanonicalModel); ok {
+			candidate = normalizer.ManagedCanonicalModel(candidate)
+		}
+		if candidate == canonical {
+			found = true
+			break
+		}
+	}
+	if !found {
+		return nil, nil, fmt.Errorf("managed canonical model not mapped for account")
+	}
+	a.UpstreamModel = canonical
+	a.Accept(auth.ID, canonical)
+	return executor, auth.Clone(), nil
+}
+func (m *Manager) executeManaged(ctx context.Context, req ex.Request, opts ex.Options) (ex.Response, error) {
+	a := managed.From(ctx)
+	executor, auth, err := m.managedSelection(ctx, req, opts)
+	if err != nil {
+		if !errors.Is(err, managed.ErrReplay) {
+			a.Finish(true)
+		}
+		return ex.Response{}, err
+	}
+	req.Model = a.UpstreamModel
+	// No model pools, auth refresh, conductor retries or plugin after-auth mutation.
+	resp, err := executor.Execute(ctx, auth, req, opts)
+	a.Finish(err != nil)
+	return resp, err
+}
+func (m *Manager) streamManaged(ctx context.Context, req ex.Request, opts ex.Options) (*ex.StreamResult, error) {
+	a := managed.From(ctx)
+	executor, auth, err := m.managedSelection(ctx, req, opts)
+	if err != nil {
+		if !errors.Is(err, managed.ErrReplay) {
+			a.Finish(true)
+		}
+		return nil, err
+	}
+	req.Model = a.UpstreamModel
+	result, err := executor.ExecuteStream(ctx, auth, req, opts)
+	if err != nil || result == nil {
+		a.Finish(true)
+		return result, err
+	}
+	out := make(chan ex.StreamChunk)
+	go func() {
+		defer close(out)
+		failed := false
+		defer func() { a.Finish(failed) }()
+		for chunk := range result.Chunks {
+			if chunk.Err != nil {
+				failed = true
+			}
+			select {
+			case out <- chunk:
+			case <-ctx.Done():
+				failed = true
+				return
+			}
+		}
+	}()
+	return &ex.StreamResult{Headers: result.Headers, Chunks: out}, nil
+}
