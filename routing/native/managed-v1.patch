+package managed
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestManagedHTTPGuardPreventsReplayAndStripsPrivateHeaders(t *testing.T) {
+	calls := 0
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		if r.Header.Get("X-AI-Bills-Token") != "" {
+			t.Error("leaked token")
+		}
+		w.WriteHeader(429)
+	}))
+	defer s.Close()
+	a, _ := New(t.Name(), "auth", nil)
+	ctx := With(context.Background(), a)
+	client := Guard(ctx, s.Client())
+	for i := 0; i < 2; i++ {
+		r, _ := http.NewRequestWithContext(ctx, "POST", s.URL, strings.NewReader("{}"))
+		r.Header.Set("X-AI-Bills-Token", "private")
+		resp, err := client.Do(r)
+		if resp != nil {
+			io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+		}
+		if i == 1 && err == nil {
+			t.Error("replay accepted")
+		}
+	}
+	if calls != 1 {
+		t.Fatalf("calls %d", calls)
+	}
+}
+func TestManagedReceiptSeparatesCompletionFromBillingEvidence(t *testing.T) {
+	a, _ := New(t.Name(), "auth", nil)
+	a.Accept("auth", "model")
+	a.Usage("auth", "model", true, map[string]any{"total_tokens": int64(0)})
+	a.Finish(true)
+	r, _ := Receipt(a.ID)
+	if r["usage_complete"] != false || r["terminal"] != true {
+		t.Fatal(r)
+	}
+}
+func TestManagedFinalOutputAndTierGuard(t *testing.T) {
+	for name, body := range map[string]string{"cap": `{"model":"model","max_tokens":101}`, "missing": `{"model":"model"}`, "tier": `{"model":"model","max_tokens":100,"service_tier":"priority"}`, "model": `{"model":"other","max_tokens":100}`, "tool": `{"model":"model","max_tokens":100,"tools":[{"type":"web_search"}]}`} {
+		t.Run(name, func(t *testing.T) {
+			a, _ := New(t.Name(), "auth", nil)
+			a.Accept("auth", "model")
+			a.MaxOutput = 100
+			r, _ := http.NewRequest("POST", "http://example.invalid", strings.NewReader(body))
+			if err := a.validateRequest(r); err == nil {
+				t.Fatal("unsafe transformed payload accepted")
+			}
+		})
+	}
+}
+
+func TestManagedMultiplicityAndToolShapeBounds(t *testing.T) {
+	for _, suffix := range []string{`,"n":2`, `,"n":1.5`, `,"best_of":2`, `,"candidate_count":2`, `,"tools":{}`, `,"tools":[42]`} {
+		a, _ := New(t.Name()+suffix, "account", nil)
+		a.Accept("account", "model")
+		a.MaxOutput = 100
+		r, _ := http.NewRequest("POST", "http://example.invalid", strings.NewReader(`{"model":"model","max_tokens":100`+suffix+`}`))
+		if err := a.validateRequest(r); err == nil {
+			t.Fatalf("unsafe bound accepted: %s", suffix)
+		}
+	}
+}
+func TestManagedOnlyAccountRequiresBudgetAdmission(t *testing.T) {
+	t.Setenv("AI_BILLS_MANAGED_ONLY_AUTH_IDS", "paid-account, other-paid")
+	ctx := context.Background()
+	if RequireAccount(ctx, "paid-account") == nil {
+		t.Fatal("unmanaged paid account admitted")
+	}
+	if err := RequireAccount(ctx, "subscription"); err != nil {
+		t.Fatal(err)
+	}
+	a, _ := New(t.Name(), "paid-account", nil)
+	ctx = With(ctx, a)
+	if RequireAccount(ctx, "paid-account") == nil {
+		t.Fatal("paid account without reservation admitted")
+	}
+	a.MaxOutput = 10
+	if err := RequireAccount(ctx, "paid-account"); err != nil {
+		t.Fatal(err)
+	}
+	if RequireAccount(ctx, "other-paid") == nil {
+		t.Fatal("wrong managed account admitted")
+	}
+}
+
+func TestManagedEndpointCapAndFinalContent(t *testing.T) {
+	cases := []struct {
+		path, body string
+		valid      bool
+	}{
+		{"/v1/messages", `{"model":"model","max_tokens":8}`, true},
+		{"/v1/messages", `{"model":"model","max_output_tokens":8}`, false},
+		{"/v1/responses", `{"model":"model","max_tokens":8}`, false},
+		{"/v1/responses", `{"model":"model","max_output_tokens":8}`, true},
+		{"/v1/chat/completions", `{"model":"model","max_tokens":8}`, true},
+		{"/v1/chat/completions", `{"model":"model","max_completion_tokens":8}`, true},
+		{"/v1/chat/completions", `{"model":"model","max_completion_tokens":7.5}`, false},
+		{"/v1/chat/completions", `{"model":"model","max_tokens":8,"audio":{"voice":"alloy"}}`, false},
+		{"/v1/responses", `{"model":"model","max_output_tokens":8,"previous_response_id":"resp_old"}`, false},
+		{"/v1/messages", `{"model":"model","max_tokens":8,"messages":[{"content":[{"type":"image","source":{"data":"x"}}]}]}`, false},
+	}
+	for i, c := range cases {
+		a, _ := New(fmt.Sprintf("%s/%d", t.Name(), i), "account", nil)
+		a.Accept("account", "model")
+		a.MaxOutput = 8
+		r, _ := http.NewRequest("POST", "http://example.invalid"+c.path, strings.NewReader(c.body))
+		if err := a.validateRequest(r); (err == nil) != c.valid {
+			t.Fatalf("case %d valid=%t error=%v", i, c.valid, err)
+		}
+	}
+}
