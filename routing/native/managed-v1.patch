@@ -0,0 +1,113 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	ex "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/managed"
+	"testing"
+)
+
+type managedFake struct {
+	*unauthorizedRefreshExecutor
+	status        int
+	streamFailure bool
+}
+
+func (e *managedFake) ManagedHTTPExecutor() ProviderExecutor { return e }
+func (e *managedFake) Execute(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (ex.Response, error) {
+	e.mu.Lock()
+	e.executeCalls = append(e.executeCalls, a.ID)
+	e.mu.Unlock()
+	if e.status > 0 {
+		return ex.Response{}, &Error{HTTPStatus: e.status, Message: "fixture failure"}
+	}
+	return ex.Response{Payload: []byte(a.ID)}, nil
+}
+func (e *managedFake) ExecuteStream(ctx context.Context, a *Auth, r ex.Request, o ex.Options) (*ex.StreamResult, error) {
+	e.mu.Lock()
+	e.streamCalls = append(e.streamCalls, a.ID)
+	e.mu.Unlock()
+	ch := make(chan ex.StreamChunk, 2)
+	ch <- ex.StreamChunk{Payload: []byte("first tool delta")}
+	if e.streamFailure {
+		ch <- ex.StreamChunk{Err: &Error{HTTPStatus: 429, Message: "fixture stream failure"}}
+	}
+	close(ch)
+	return &ex.StreamResult{Chunks: ch}, nil
+}
+func TestManagedExactAccountSingleInvocation(t *testing.T) {
+	for _, status := range []int{0, 401, 429, 500} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			m, base, primary, _, model := newUnauthorizedRefreshFixture(t, false)
+			f := &managedFake{unauthorizedRefreshExecutor: base, status: status}
+			m.RegisterExecutor(f)
+			a, err := managed.New("auth-test-"+t.Name(), primary.ID, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx := managed.With(context.Background(), a)
+			_, err = m.Execute(ctx, []string{"codex"}, ex.Request{Model: model}, ex.Options{})
+			if (err != nil) != (status != 0) {
+				t.Fatalf("wrong error %v", err)
+			}
+			_, _ = m.Execute(ctx, []string{"codex"}, ex.Request{Model: model}, ex.Options{})
+			if len(f.executeCalls) != 1 || f.executeCalls[0] != primary.ID || f.RefreshCalls() != 0 {
+				t.Fatalf("replayed or changed account: %v refresh=%d", f.executeCalls, f.RefreshCalls())
+			}
+		})
+	}
+}
+func TestManagedStreamDoesNotReplayAfterPartialFailure(t *testing.T) {
+	m, base, primary, _, model := newUnauthorizedRefreshFixture(t, false)
+	f := &managedFake{unauthorizedRefreshExecutor: base, streamFailure: true}
+	m.RegisterExecutor(f)
+	a, _ := managed.New("auth-stream-test", primary.ID, nil)
