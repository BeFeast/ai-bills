diff --git a/sdk/cliproxy/managed/managed.go b/sdk/cliproxy/managed/managed.go
new file mode 100644
index 0000000..616dfc9
--- /dev/null
+++ b/sdk/cliproxy/managed/managed.go
@@ -0,0 +1,346 @@
+// Package managed implements the bounded AI Bills admission contract.
+package managed
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+var ErrReplay = errors.New("managed execution replay denied")
+
+type key struct{}
+type Attempt struct {
+	ID            string
+	AuthID        string
+	UpstreamModel string
+	RequestID     string
+	MaxOutput     int64
+	ServiceTier   string
+	accepted      func(string, string)
+	execution     atomic.Bool
+	dispatch      atomic.Bool
+	mu            sync.Mutex
+	receipt       map[string]any
+}
+
+var store = struct {
+	sync.RWMutex
+	rows map[string]*Attempt
+}{rows: make(map[string]*Attempt)}
+
+func New(id, authID string, accepted func(string, string)) (*Attempt, error) {
+	store.Lock()
+	defer store.Unlock()
+	if _, exists := store.rows[id]; exists {
+		return nil, errors.New("managed attempt already exists")
+	}
+	if len(store.rows) >= 100000 {
+		return nil, errors.New("managed receipt capacity reached")
+	}
+	a := &Attempt{ID: id, AuthID: authID, accepted: accepted, receipt: map[string]any{"attempt_id": id, "auth_id": authID, "accepted": false, "complete": false, "usage_known": false, "usage_complete": false, "terminal": false, "started": false, "observed_at": time.Now().UTC().Format(time.RFC3339Nano)}}
+	store.rows[id] = a
+	return a, nil
+}
+func With(ctx context.Context, a *Attempt) context.Context { return context.WithValue(ctx, key{}, a) }
+func From(ctx context.Context) *Attempt {
+	if ctx == nil {
+		return nil
+	}
+	a, _ := ctx.Value(key{}).(*Attempt)
+	return a
+}
+func Copy(to, from context.Context) context.Context {
+	if a := From(from); a != nil {
+		return With(to, a)
+	}
+	return to
+}
+func (a *Attempt) Claim() bool { return a.execution.CompareAndSwap(false, true) }
+func (a *Attempt) Accept(authID, model string) {
+	a.mu.Lock()
+	a.receipt["accepted"] = true
+	a.receipt["auth_id"] = authID
+	a.receipt["model"] = model
+	a.mu.Unlock()
+	if a.accepted != nil {
+		a.accepted(authID, model)
+	}
+}
+func (a *Attempt) Usage(authID, model string, failed bool, detail map[string]any) {
+	if authID != a.AuthID {
+		return
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.receipt["model"] = model
+	a.receipt["failed"] = failed
+	a.receipt["usage"] = detail
+	total, _ := detail["total_tokens"].(int64)
+	quality, _ := detail["quality_complete"].(bool)
+	a.receipt["usage_known"] = !failed && total > 0 && quality
+	a.receipt["usage_complete"] = !failed && total > 0 && quality
+}
+func (a *Attempt) Finish(failed bool) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.receipt["complete"] = true
+	a.receipt["terminal"] = true
+	a.receipt["billable_zero"] = failed && !a.dispatch.Load()
+	a.receipt["failed"] = failed
+}
+func Receipt(id string) (map[string]any, bool) {
+	store.RLock()
+	a, ok := store.rows[id]
+	store.RUnlock()
+	if !ok {
+		return nil, false
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	r := make(map[string]any, len(a.receipt))
+	for k, v := range a.receipt {
+		r[k] = v
+	}
+	return r, true
+}
+
+// Guard applies to every managed HTTP client, including per-provider inner retries.
+func Guard(ctx context.Context, client *http.Client) *http.Client {
+	a := From(ctx)
+	if a == nil {
+		return client
+	}
+	clone := *client
+	base := clone.Transport
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	clone.Transport = transport{base: base, attempt: a}
+	clone.CheckRedirect = func(*http.Request, []*http.Request) error { return errors.New("managed redirects disabled") }
+	return &clone
+}
+
+type transport struct {
+	base    http.RoundTripper
+	attempt *Attempt
+}
+
+func (t transport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if err := t.attempt.validateRequest(r); err != nil {
+		return nil, err
+	}
+	if !t.attempt.dispatch.CompareAndSwap(false, true) {
+		return nil, errors.New("managed upstream replay denied")
+	}
+	t.attempt.mu.Lock()
+	t.attempt.receipt["started"] = true
+	t.attempt.mu.Unlock()
+	clone := r.Clone(r.Context())
+	clone.Header = r.Header.Clone()
+	for _, name := range []string{"X-AI-Bills-Managed", "X-AI-Bills-Token", "X-AI-Bills-Auth-ID", "X-AI-Bills-Attempt-ID", "X-AI-Bills-Request-ID", "X-AI-Bills-Max-Output", "X-AI-Bills-Service-Tier", "X-AI-Bills-Upstream-Model"} {
+		clone.Header.Del(name)
+	}
+	// Go's transport cannot transparently replay this request body on a reused connection.
+	clone.GetBody = nil
+	return t.base.RoundTrip(clone)
+}
+
+// Validate the final translated payload, not merely the original client request.
+func (a *Attempt) validateRequest(r *http.Request) error {
+	if r.Body == nil {
+		return errors.New("managed request body required")
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, 64*1024*1024+1))
+	if err != nil {
+		return err
+	}
+	r.Body.Close()
+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	if len(raw) > 64*1024*1024 {
+		return errors.New("managed request body too large")
+	}
+	body := raw
+	if r.Header.Get("Content-Encoding") == "gzip" {
+		reader, err := gzip.NewReader(bytes.NewReader(raw))
+		if err != nil {
+			return err
+		}
+		body, err = io.ReadAll(io.LimitReader(reader, 64*1024*1024+1))
+		reader.Close()
+		if err != nil || len(body) > 64*1024*1024 {
+			return errors.New("managed compressed body invalid")
+		}
+	}
+	var value map[string]any
+	if json.Unmarshal(body, &value) != nil {
+		return errors.New("managed JSON body required")
+	}
+	a.mu.Lock()
+	model, _ := a.receipt["model"].(string)
+	a.mu.Unlock()
+	if model != "" && value["model"] != model {
+		return errors.New("managed transformed model mismatch")
+	}
+	if a.MaxOutput <= 0 {
+		return nil
+	}
+	for _, field := range []string{"n", "best_of", "candidate_count"} {
+		if raw, exists := value[field]; exists && raw != float64(1) {
+			return errors.New("managed multiple generations denied")
+		}
+	}
+	if value["speed"] == "fast" {
+		return errors.New("managed unpriced fast service denied")
+	}
+	for _, key := range []string{"previous_response_id", "conversation", "background", "audio", "prediction"} {
+		if raw, exists := value[key]; exists && raw != nil && raw != false && raw != "" {
+			return errors.New("managed unbounded context or unpriced feature denied")
+		}
+	}
+	if raw, exists := value["modalities"]; exists {
+		modes, ok := raw.([]any)
+		if !ok {
+			return errors.New("managed malformed modalities")
+		}
+		for _, mode := range modes {
+			if mode != "text" {
+				return errors.New("managed unpriced output modality")
+			}
+		}
+	}
+	if unpricedContent(value) {
+		return errors.New("managed unpriced content denied")
+	}
+	fields := []string{}
+	switch {
+	case strings.HasSuffix(r.URL.Path, "/messages"):
+		fields = []string{"max_tokens"}
+	case strings.HasSuffix(r.URL.Path, "/responses"):
+		fields = []string{"max_output_tokens"}
+	case strings.HasSuffix(r.URL.Path, "/chat/completions"):
+		fields = []string{"max_tokens", "max_completion_tokens"}
+	default:
+		return errors.New("managed unpriced endpoint denied")
+	}
+	bounded := false
+	for _, field := range fields {
+		if raw, ok := value[field]; ok {
+			limit, ok := raw.(float64)
+			if !ok || limit <= 0 || math.Trunc(limit) != limit || limit > float64(a.MaxOutput) {
+				return errors.New("managed transformed output limit exceeds reservation")
+			}
+			bounded = true
+		}
+	}
+	if !bounded {
+		return errors.New("managed transformed output limit absent")
+	}
+	tier, _ := value["service_tier"].(string)
+	if tier == "" {
+		tier = "default"
+	}
+	expected := a.ServiceTier
+	if expected == "" {
+		expected = "default"
+	}
+	if tier != expected {
+		return errors.New("managed transformed service tier differs from reservation")
+	}
+	// Paid v1 initially admits text + client-side function tools only.
+	if raw, exists := value["tools"]; exists && raw != nil {
+		tools, ok := raw.([]any)
+		if !ok {
+			return errors.New("managed malformed tools denied")
+		}
+		for _, raw := range tools {
+			tool, valid := raw.(map[string]any)
+			if !valid {
+				return errors.New("managed malformed tool denied")
+			}
+			kind, _ := tool["type"].(string)
+			if kind != "" && kind != "function" && kind != "custom" {
+				return errors.New("managed unpriced provider tool denied")
+			}
+		}
+	}
+	return nil
+}
+
+// Only explicitly enrolled paid account IDs require the budget authority. Other
+// accounts keep their existing behavior. This does not change credential ownership.
+func RequireAccount(ctx context.Context, authID string) error {
+	for _, id := range strings.Split(os.Getenv("AI_BILLS_MANAGED_ONLY_AUTH_IDS"), ",") {
+		if id = strings.TrimSpace(id); id != "" && id == authID {
+			a := From(ctx)
+			if a == nil || a.AuthID != authID || a.MaxOutput <= 0 {
+				return errors.New("paid account requires managed budget admission")
+			}
+		}
+	}
+	return nil
+}
+
+// Responses-only upstreams are explicitly bound to account IDs, never inferred
+// from a model display name or silently substituted for chat/completions.
+func ResponsesAccount(ctx context.Context, authID string) bool {
+	if From(ctx) == nil {
+		return false
+	}
+	for _, id := range strings.Split(os.Getenv("AI_BILLS_RESPONSES_AUTH_IDS"), ",") {
+		if strings.TrimSpace(id) == authID && authID != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// GuardAccount also covers executor HTTPCall paths that bypass normal selection.
+func GuardAccount(ctx context.Context, client *http.Client, authID string) *http.Client {
+	if err := RequireAccount(ctx, authID); err != nil {
+		clone := *client
+		clone.Transport = deniedTransport{err: err}
+		return &clone
+	}
+	return Guard(ctx, client)
+}
+
+type deniedTransport struct{ err error }
+
+func (d deniedTransport) RoundTrip(*http.Request) (*http.Response, error) { return nil, d.err }
+
+func unpricedContent(value any) bool {
+	switch node := value.(type) {
+	case map[string]any:
+		kind, _ := node["type"].(string)
+		switch kind {
+		case "image_url", "input_image", "input_audio", "audio", "image", "document", "file", "input_file", "computer", "web_search", "web_search_preview", "file_search", "code_interpreter":
+			return true
+		}
+		if _, ok := node["source"].(map[string]any); ok {
+			return true
+		}
+		for _, child := range node {
+			if unpricedContent(child) {
+				return true
+			}
+		}
+	case []any:
+		for _, child := range node {
+			if unpricedContent(child) {
+				return true
+			}
+		}
+	}
+	return false
+}
diff --git a/sdk/cliproxy/managed/managed_test.go b/sdk/cliproxy/managed/managed_test.go
