@@ -0,0 +1,179 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	auth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	ex "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/managed"
+	translator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+)
+
+func TestManagedRealHTTPExecutorsSingleRequestOnErrors(t *testing.T) {
+	for _, provider := range []string{"claude", "codex", "kimi", "openai-compatibility"} {
+		for _, stream := range []bool{false, true} {
+			for _, status := range []int{401, 429, 500} {
+				t.Run(fmt.Sprintf("%s/%t/%d", provider, stream, status), func(t *testing.T) {
+					calls := 0
+					server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						calls++
+						if r.Header.Get("X-AI-Bills-Token") != "" {
+							t.Error("private token leaked")
+						}
+						w.WriteHeader(status)
+						fmt.Fprint(w, `{"error":{"message":"fixture failure"}}`)
+					}))
+					defer server.Close()
+					cfg := &config.Config{}
+					var executor auth.ProviderExecutor
+					switch provider {
+					case "claude":
+						executor = NewClaudeExecutor(cfg)
+					case "kimi":
+						executor = NewKimiExecutor(cfg).ManagedHTTPExecutor()
+					case "codex":
+						executor = NewCodexAutoExecutor(cfg).ManagedHTTPExecutor()
+					default:
+						executor = NewOpenAICompatExecutor("fixture", cfg)
+					}
+					a := &auth.Auth{ID: "fixture-account", Provider: provider, Attributes: map[string]string{"api_key": "fixture-key", "base_url": server.URL}}
+					attempt, err := managed.New(t.Name(), a.ID, nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					attempt.Accept(a.ID, "fixture-model")
+					ctx := managed.With(context.Background(), attempt)
+					if provider == "kimi" {
+						target, _ := url.Parse(server.URL)
+						ctx = context.WithValue(ctx, "cliproxy.roundtripper", managedFixtureTransport{target: target, base: server.Client().Transport})
+					}
+					req := ex.Request{Model: "fixture-model", Payload: []byte(`{"model":"fixture-model","messages":[{"role":"user","content":"test"}],"max_tokens":8}`)}
+					opts := ex.Options{SourceFormat: translator.FromString("openai"), Stream: stream}
+					if stream {
+						_, err = executor.ExecuteStream(ctx, a, req, opts)
+					} else {
+						_, err = executor.Execute(ctx, a, req, opts)
+					}
+					if err == nil || calls != 1 {
+						t.Fatalf("calls=%d error=%v", calls, err)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestManagedResponsesOnlyExecutorUsesGenericResponses(t *testing.T) {
+	for _, source := range []translator.Format{translator.FormatOpenAIResponse, translator.FormatOpenAI} {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/%t", source, stream), func(t *testing.T) {
+				t.Setenv("AI_BILLS_RESPONSES_AUTH_IDS", "fixture-responses")
+				calls := 0
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					calls++
+					if r.URL.Path != "/responses" {
+						t.Errorf("wrong upstream protocol: %s", r.URL.Path)
+					}
+					var body map[string]any
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Fatal(err)
+					}
+					if _, ok := body["input"]; !ok {
+						t.Error("missing Responses input")
+					}
+					if _, ok := body["messages"]; ok {
+						t.Error("chat payload sent to Responses")
+					}
+					if body["max_output_tokens"] != float64(8) {
+						t.Errorf("lost output cap: %v", body)
+					}
+					if source == translator.FormatOpenAI {
+						if _, ok := body["include"]; ok {
+							t.Error("Codex-only defaults leaked")
+						}
+					}
+					response := `{"id":"resp_fixture","object":"response","model":"fixture-model","status":"completed","output":[{"type":"message","id":"msg_fixture","role":"assistant","status":"completed","content":[{"type":"output_text","text":"ok","annotations":[]}]}],"usage":{"input_tokens":10,"output_tokens":2,"total_tokens":12}}`
+					if stream {
+						w.Header().Set("Content-Type", "text/event-stream")
+						fmt.Fprintf(w, "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":%s}\n\n", response)
+					} else {
+						w.Header().Set("Content-Type", "application/json")
+						fmt.Fprint(w, response)
+					}
+				}))
+				defer server.Close()
+				account := &auth.Auth{ID: "fixture-responses", Provider: "fixture", Attributes: map[string]string{"api_key": "fixture-key", "base_url": server.URL}}
+				a, _ := managed.New(t.Name(), account.ID, nil)
+				a.Accept(account.ID, "fixture-model")
+				ctx := managed.With(context.Background(), a)
+				executor := NewOpenAICompatExecutor("fixture", &config.Config{})
+				request := ex.Request{Model: "fixture-model", Payload: []byte(`{"model":"fixture-model","input":"hello","max_output_tokens":8}`)}
+				if source == translator.FormatOpenAI {
+					request.Payload = []byte(`{"model":"fixture-model","messages":[{"role":"user","content":"hello"}],"max_tokens":8}`)
+				}
+				opts := ex.Options{SourceFormat: source, Stream: stream}
+				if stream {
+					result, err := executor.ExecuteStream(ctx, account, request, opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					chunks := 0
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							t.Fatal(chunk.Err)
+						}
+						chunks++
+					}
+					if chunks == 0 {
+						t.Fatal("no stream chunks")
+					}
+				} else {
+					if _, err := executor.Execute(ctx, account, request, opts); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if calls != 1 {
+					t.Fatalf("calls=%d", calls)
+				}
+				receipt, _ := managed.Receipt(a.ID)
+				if receipt["usage_complete"] != true {
+					t.Fatalf("missing usage: %v", receipt)
+				}
+			})
+		}
+	}
+}
+
+type managedFixtureTransport struct {
+	target *url.URL
+	base   http.RoundTripper
+}
+
+func (f managedFixtureTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	c := r.Clone(r.Context())
+	u := *r.URL
+	u.Scheme = f.target.Scheme
+	u.Host = f.target.Host
+	c.URL = &u
+	c.Host = f.target.Host
+	base := f.base
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	return base.RoundTrip(c)
+}
+func TestManagedKimiExecutorRetainsCanonicalProtocol(t *testing.T) {
+	e := NewKimiExecutor(&config.Config{})
+	if e.ManagedHTTPExecutor() != e {
+		t.Fatal("embedded Claude executor substituted")
+	}
+	if got := e.ManagedCanonicalModel("kimi-k2.7-code-highspeed"); got != "kimi-for-coding-highspeed" {
+		t.Fatalf("model=%s", got)
+	}
+}
