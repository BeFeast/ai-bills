@@ -0,0 +1,49 @@
+package api
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/managed"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestManagedMiddlewarePrivateHeadersAndReceipt(t *testing.T) {
+	t.Setenv("AI_BILLS_MANAGED_TOKEN", "test-private-token")
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	r.Use(managedMiddleware())
+	r.POST("/v1/messages", func(c *gin.Context) {
+		if c.GetHeader("X-AI-Bills-Token") != "" {
+			t.Error("secret leaked")
+		}
+		a := managed.From(c.Request.Context())
+		if a == nil {
+			t.Error("missing context")
+			return
+		}
+		a.Accept(a.AuthID, "model")
+		c.Status(200)
+	})
+	request := func(token, id string) *httptest.ResponseRecorder {
+		q := httptest.NewRequest("POST", "/v1/messages", strings.NewReader(`{"model":"model"}`))
+		q.Header.Set("X-AI-Bills-Managed", "1")
+		q.Header.Set("X-AI-Bills-Token", token)
+		q.Header.Set("X-AI-Bills-Auth-ID", "actual-auth-id")
+		q.Header.Set("X-AI-Bills-Attempt-ID", id)
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, q)
+		return w
+	}
+	id := "01234567-0000-0000-0000-000000000001"
+	if w := request("wrong", id); w.Code != http.StatusUnauthorized || w.Header().Get("X-AI-Bills-Managed-Version") != "" {
+		t.Fatalf("invalid auth receipt %d", w.Code)
+	}
+	if w := request("test-private-token", id); w.Code != 200 || w.Header().Get("X-AI-Bills-Auth-ID") != "actual-auth-id" {
+		t.Fatalf("missing actual receipt %d", w.Code)
+	}
+	if w := request("test-private-token", id); w.Code != 409 {
+		t.Fatalf("duplicate accepted %d", w.Code)
+	}
+}
