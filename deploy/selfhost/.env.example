# Copy to .env next to compose.yaml. Nothing here is read by git.
# SHA-256 of the ingest token the collector will send (generate both with `deploy/selfhost/new-token.sh`).
AI_BILLS_INGEST_TOKEN_SHA256=
# Database passwords (any long random strings; `new-token.sh` prints a pair too). The owner applies
# migrations at boot; the application role is bound by row-level security.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# Optional: where the dashboard listens (default loopback only, port 13180).
#AI_BILLS_BIND=127.0.0.1
#AI_BILLS_PORT=13180
# Optional: the app's own public address, used only for links in notifications.
#AI_BILLS_PUBLIC_ORIGIN=http://127.0.0.1:13180
